@@ -0,0 +1,94 @@
+//! Starting a distribution build: the game's files come from a `game` folder next to the
+//! executable (made by the setup tool from the player's own dump), the log goes to
+//! `<exe name>.log` when there is no console, and startup problems are shown in a message box.
+
+use std::path::PathBuf;
+
+/// The folder holding the player's `exefs\` and `romfs.bin`.
+pub fn game_folder() -> PathBuf {
+    if let Some(p) = crate::env_var!("KIRIKAE_GAME") {
+        return p.into();
+    }
+    let exe = std::env::current_exe().unwrap_or_default();
+    exe.parent().map(|d| d.join("game")).unwrap_or_else(|| PathBuf::from("game"))
+}
+
+pub fn log_path() -> Option<PathBuf> {
+    let exe = std::env::current_exe().ok()?;
+    let stem = exe.file_stem()?.to_string_lossy().into_owned();
+    Some(exe.with_file_name(format!("{stem}.log")))
+}
+
+/// Without a console (started from Explorer), send stdout and stderr to the log file.
+pub fn log_without_console() {
+    #[cfg(windows)]
+    win::log_without_console();
+}
+
+/// Tell the player something went wrong before the window opened, and quit.
+pub fn fail(text: &str) -> ! {
+    eprintln!("kirikae: {text}");
+    #[cfg(windows)]
+    win::message_box(text);
+    std::process::exit(3)
+}
+
+#[cfg(windows)]
+mod win {
+    use std::ffi::c_void;
+    use std::os::windows::ffi::OsStrExt;
+    use std::os::windows::io::IntoRawHandle;
+
+    const STD_OUTPUT_HANDLE: u32 = -11i32 as u32;
+    const STD_ERROR_HANDLE: u32 = -12i32 as u32;
+    const MB_OK: u32 = 0;
+    const MB_ICONERROR: u32 = 0x10;
+
+    unsafe extern "system" {
+        fn GetStdHandle(which: u32) -> *mut c_void;
+        fn SetStdHandle(which: u32, handle: *mut c_void) -> i32;
+        fn GetFileType(handle: *mut c_void) -> u32;
+    }
+    #[link(name = "user32")]
+    unsafe extern "system" {
+        fn MessageBoxW(owner: *mut c_void, text: *const u16, caption: *const u16, kind: u32) -> i32;
+    }
+
+    fn missing(h: *mut c_void) -> bool {
+        // NULL (GUI program), INVALID_HANDLE_VALUE, or a handle of unknown type.
+        h.is_null() || h as isize == -1 || unsafe { GetFileType(h) } == 0
+    }
+
+    pub fn log_without_console() {
+        let (out, err) = unsafe { (GetStdHandle(STD_OUTPUT_HANDLE), GetStdHandle(STD_ERROR_HANDLE)) };
+        if !missing(err) {
+            return;
+        }
+        let Some(path) = super::log_path() else { return };
+        let Ok(file) = std::fs::File::create(&path) else { return };
+        let h = file.into_raw_handle();
+        unsafe {
+            SetStdHandle(STD_ERROR_HANDLE, h);
+            if missing(out) {
+                SetStdHandle(STD_OUTPUT_HANDLE, h);
+            }
+        }
+        // Nobody sees a panic message without a console: say where it went.
+        let default = std::panic::take_hook();
+        std::panic::set_hook(Box::new(move |info| {
+            default(info);
+            static SHOWN: std::sync::Once = std::sync::Once::new();
+            SHOWN.call_once(|| message_box(&format!("The game crashed. Details are in {}.", path.display())));
+        }));
+    }
+
+    fn wide(s: &str) -> Vec<u16> {
+        std::ffi::OsStr::new(s).encode_wide().chain([0]).collect()
+    }
+
+    pub fn message_box(text: &str) {
+        let name = std::env::current_exe().ok().and_then(|e| e.file_stem().map(|s| s.to_string_lossy().into_owned()));
+        let (t, c) = (wide(text), wide(name.as_deref().unwrap_or("kirikae")));
+        unsafe { MessageBoxW(std::ptr::null_mut(), t.as_ptr(), c.as_ptr(), MB_OK | MB_ICONERROR) };
+    }
+}
