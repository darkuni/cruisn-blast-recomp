+/// A package for distribution: names, sizes and hashes of the ExeFS files instead of the files,
+/// and the RomFS image as a path relative to the game folder. The player supplies the files
+/// from their own dump (`game\exefs\...` and `game\romfs.bin` next to the executable).
+const EXTERNAL_MAGIC: &[u8; 8] = b"KRKEXT01";
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ExternalFile {
+    pub name: String,
+    pub size: u64,
+    pub hash: u64,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct External {
+    pub title: Option<u64>,
+    pub files: Vec<ExternalFile>,
+    /// Relative to the game folder.
+    pub romfs: Option<String>,
+}
+
+/// FNV-1a 64: tells one dump version from another (not a security check).
+pub fn file_hash(bytes: &[u8]) -> u64 {
+    let mut h: u64 = 0xcbf2_9ce4_8422_2325;
+    for &b in bytes {
+        h ^= u64::from(b);
+        h = h.wrapping_mul(0x0000_0100_0000_01b3);
+    }
+    h
+}
+
+pub fn is_external(blob: &[u8]) -> bool {
+    blob.starts_with(EXTERNAL_MAGIC)
+}
+
+/// Turn a normal embedded package into a distribution package.
+pub fn externalize(blob: &[u8], romfs_name: &str) -> Result<Vec<u8>, Error> {
+    let Source::ExeFs(files, title, romfs) = unpack_source(blob)? else {
+        return Err(Error::Malformed("only ExeFS dumps can be packaged without the game"));
+    };
+    let mut out = EXTERNAL_MAGIC.to_vec();
+    out.extend_from_slice(&title.unwrap_or(0).to_le_bytes());
+    out.extend_from_slice(&(files.len() as u32).to_le_bytes());
+    for (name, bytes) in &files {
+        out.extend_from_slice(&(name.len() as u16).to_le_bytes());
+        out.extend_from_slice(name.as_bytes());
+        out.extend_from_slice(&(bytes.len() as u64).to_le_bytes());
+        out.extend_from_slice(&file_hash(bytes).to_le_bytes());
+    }
+    let r = if romfs.is_some() { romfs_name } else { "" };
+    out.extend_from_slice(&(r.len() as u16).to_le_bytes());
+    out.extend_from_slice(r.as_bytes());
+    Ok(out)
+}
+
+pub fn unpack_external(blob: &[u8]) -> Result<External, Error> {
+    let bad = || Error::Malformed("bad distribution package");
+    let take = |at: &mut usize, n: usize| -> Result<&[u8], Error> {
+        let s = blob.get(*at..*at + n).ok_or_else(bad)?;
+        *at += n;
+        Ok(s)
+    };
+    let mut at = 0;
+    if take(&mut at, 8)? != EXTERNAL_MAGIC {
+        return Err(bad());
+    }
+    let title = u64::from_le_bytes(take(&mut at, 8)?.try_into().unwrap());
+    let count = u32::from_le_bytes(take(&mut at, 4)?.try_into().unwrap());
+    let mut files = Vec::new();
+    for _ in 0..count {
+        let len = u16::from_le_bytes(take(&mut at, 2)?.try_into().unwrap()) as usize;
+        let name = String::from_utf8_lossy(take(&mut at, len)?).into_owned();
+        let size = u64::from_le_bytes(take(&mut at, 8)?.try_into().unwrap());
+        let hash = u64::from_le_bytes(take(&mut at, 8)?.try_into().unwrap());
+        files.push(ExternalFile { name, size, hash });
+    }
+    let len = u16::from_le_bytes(take(&mut at, 2)?.try_into().unwrap()) as usize;
+    let romfs = String::from_utf8_lossy(take(&mut at, len)?).into_owned();
+    Ok(External { title: (title != 0).then_some(title), files, romfs: (!romfs.is_empty()).then_some(romfs) })
+}
+
+/// Why the player's game folder does not match what the executable was built from.
+#[derive(Debug, PartialEq, Eq)]
+pub enum Mismatch {
+    Missing(String),
+    Different(String),
+    NoRomFs(String),
+}
+
+impl std::fmt::Display for Mismatch {
+    fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
+        match self {
+            Mismatch::Missing(p) => write!(f, "{p} is missing"),
+            Mismatch::Different(p) => write!(f, "{p} is from a different version of the game"),
+            Mismatch::NoRomFs(p) => write!(f, "{p} is missing"),
+        }
+    }
+}
+
+/// Read the ExeFS files from `<game>/exefs/` and check them; the RomFS image is `<game>/<romfs>`.
+pub fn load_external(ext: &External, game: &Path) -> Result<Source, Mismatch> {
+    let exefs = game.join("exefs");
+    let mut files = Vec::new();
+    for f in &ext.files {
+        let path = exefs.join(&f.name);
+        let shown = path.display().to_string();
+        let bytes = std::fs::read(&path).map_err(|_| Mismatch::Missing(shown.clone()))?;
+        if bytes.len() as u64 != f.size || file_hash(&bytes) != f.hash {
+            return Err(Mismatch::Different(shown));
+        }
+        files.push((f.name.clone(), bytes));
+    }
+    let romfs = match &ext.romfs {
+        Some(name) => {
+            let image = game.join(name);
+            let size = std::fs::metadata(&image).map_err(|_| Mismatch::NoRomFs(image.display().to_string()))?.len();
+            Some(RomFs { path: std::path::absolute(&image).unwrap_or(image), offset: 0, size, compression: None })
+        }
+        None => None,
+    };
+    Ok(Source::ExeFs(files, ext.title, romfs))
+}
+
 #[cfg(test)]
 mod tests {
     use super::*;
 
+    #[test]
+    fn distribution_package_checks_the_players_files() {
+        let dir = std::env::temp_dir().join(format!("kirikae-ext-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(dir.join("exefs")).unwrap();
+        let romfs = RomFs { path: dir.join("old-romfs.bin"), offset: 0, size: 4, compression: None };
+        let source = Source::ExeFs(vec![("main".into(), b"guest code".to_vec()), ("sdk".into(), b"sdk".to_vec())], Some(APP_ID), Some(romfs));
+        let ext_blob = externalize(&pack(&source), "romfs.bin").unwrap();
+        assert!(is_external(&ext_blob) && !is_external(&pack(&source)));
+        let ext = unpack_external(&ext_blob).unwrap();
+        assert_eq!(ext.files.len(), 2);
+        assert_eq!(ext.romfs.as_deref(), Some("romfs.bin"));
+        assert!(!String::from_utf8_lossy(&ext_blob).contains("guest code"));
+
+        assert!(matches!(load_external(&ext, &dir), Err(Mismatch::Missing(_))));
+        std::fs::write(dir.join("exefs/main"), b"guest cod3").unwrap();
+        std::fs::write(dir.join("exefs/sdk"), b"sdk").unwrap();
+        assert!(matches!(load_external(&ext, &dir), Err(Mismatch::Different(_))));
+        std::fs::write(dir.join("exefs/main"), b"guest code").unwrap();
+        assert!(matches!(load_external(&ext, &dir), Err(Mismatch::NoRomFs(_))));
+        std::fs::write(dir.join("romfs.bin"), b"romfs image").unwrap();
+        let Source::ExeFs(files, title, Some(r)) = load_external(&ext, &dir).unwrap() else { panic!() };
+        assert_eq!((files[0].1.as_slice(), title, r.size), (&b"guest code"[..], Some(APP_ID), 11));
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
     const APP_ID: u64 = 0x0100_0000_0000_0000;
 
     #[test]
