+
+fn mov_cbuf(rd: u64, slot: u64, offset: u64) -> u64 {
+    0x4c98_0000_0000_0000 | 0xf << 39 | slot << 34 | (offset / 4) << 20 | PT | rd
+}
+fn lop_or_cbuf(rd: u64, ra: u64, slot: u64, offset: u64) -> u64 {
+    0x4c40_0000_0000_0000 | 1 << 41 | slot << 34 | (offset / 4) << 20 | PT << 32 | PT | ra << 8 | rd
+}
+
+#[test]
+fn bindless_tex_from_nvn_texture_or_sampler_handle() {
+    // The pattern Cruis'n Blast's shaders use: mov R13, c2[0x168]; lop.or R13, R13, c2[0x568]
+    let code = program(
+        fragment_header(1),
+        &[mov_cbuf(13, 2, 0x168), ipa(0, 0x80, 0xff), lop_or_cbuf(13, 13, 2, 0x568), ipa(1, 0x84, 0xff), tex_b_2d(4, 0, 13, 0), EXIT],
+    );
+    let shader = translate(&code, &options(Stage::Fragment), &kirikae_maxwell::NoEnv).unwrap();
+    assert!(shader.unsupported.is_empty(), "{:?}", shader.unsupported);
+    let t = shader.textures[0];
+    assert_eq!((t.slot, t.handle, t.or), (Some(2), 0x168 / 4, Some((2, 0x568 / 4))));
+    validate(&shader.spirv);
+}
+
+#[test]
+fn bindless_or_word_does_not_leak_into_a_later_bound_texture() {
+    let code = program(
+        fragment_header(1),
+        &[mov_cbuf(13, 2, 0x10), lop_or_cbuf(13, 13, 2, 0x20), ipa(0, 0x80, 0xff), ipa(1, 0x84, 0xff), tex_b_2d(4, 0, 13, 0), texs_2d(8, 0, 1, 3), EXIT],
+    );
+    let shader = translate(&code, &options(Stage::Fragment), &kirikae_maxwell::NoEnv).unwrap();
+    assert!(shader.unsupported.is_empty(), "{:?}", shader.unsupported);
+    let bound = shader.textures.iter().find(|t| t.slot.is_none()).unwrap();
+    assert_eq!((bound.handle, bound.or), (3, None));
+    validate(&shader.spirv);
+}
