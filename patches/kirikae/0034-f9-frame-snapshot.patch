diff --git a/crates/rt/src/gpu/vulkan/bisect.rs b/crates/rt/src/gpu/vulkan/bisect.rs
index d2262f1..4ea2326 100644
--- a/crates/rt/src/gpu/vulkan/bisect.rs
+++ b/crates/rt/src/gpu/vulkan/bisect.rs
@@ -4,9 +4,26 @@
 //! such as bloom, colour grading and tonemapping, and on-screen banners) is listed in the order it
 //! was first seen. F6 / F7 skip the next / previous one in that list, F8 stops skipping. The
 //! window title and the log show which shader is being skipped, so the one that makes the
-//! problem disappear can be reported by its address. The keys only work with KIRIKAE_GPU_DIAG.
+//! problem disappear can be reported by its address. F9 saves every image the GPU has drawn
+//! into at the next frame (PNG and raw values) to target-dump/ next to the game. The keys only
+//! work with KIRIKAE_GPU_DIAG.
 
 use std::sync::Mutex;
+use std::sync::atomic::{AtomicBool, Ordering};
+
+/// F9: save every image the GPU has drawn into at the next frame (target-dump/ next to the game).
+static SNAPSHOT: AtomicBool = AtomicBool::new(false);
+
+pub fn request_snapshot() {
+    if super::diag::wanted_checkpoints() {
+        SNAPSHOT.store(true, Ordering::Relaxed);
+        eprintln!("kirikae: bisect: saving the drawn images of the next frame to target-dump");
+    }
+}
+
+pub fn take_snapshot() -> bool {
+    SNAPSHOT.swap(false, Ordering::Relaxed)
+}
 
 struct State {
     seen: Vec<u64>,
