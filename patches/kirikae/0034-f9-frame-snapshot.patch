diff --git a/crates/maxwell/examples/mnemonics.rs b/crates/maxwell/examples/mnemonics.rs
new file mode 100644
index 0000000..23c63bc
--- /dev/null
+++ b/crates/maxwell/examples/mnemonics.rs
@@ -0,0 +1,11 @@
+//! Instruction counts of one dumped shader: cargo run -p kirikae-maxwell --example mnemonics -- <file> <fragment|vertex>
+use kirikae_maxwell::{NoEnv, Options, Stage, translate};
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let stage = if a[2] == "fragment" { Stage::Fragment } else { Stage::Vertex };
+    let s = translate(&std::fs::read(&a[1]).unwrap(), &Options::new(stage, 0), &NoEnv).unwrap();
+    for (m, n) in &s.mnemonics {
+        println!("{n:4} {m}");
+    }
+    println!("textures: {:?}", s.textures);
+}
