@@ -0,0 +1,179 @@
+//! Vector instructions lifted to IR (lift_fp, lift_neon) compiled with Cranelift must give the
+//! same registers as the vector interpreter.
+
+use std::collections::BTreeSet;
+
+use cranelift_jit::{JITBuilder, JITModule};
+use kirikae_a64::simd::Env;
+use kirikae_a64::{Insn, Stmt};
+use kirikae_recomp::clif::{host_isa, Compiler};
+use kirikae_recomp::{Block, Function};
+use kirikae_rt::abi;
+
+#[derive(Clone, Debug, PartialEq)]
+struct State {
+    x: [u64; 32],
+    v: [u128; 32],
+    fpcr: u64,
+    fpsr: u64,
+}
+
+impl Env for State {
+    fn x(&self, n: u32) -> u64 {
+        if n == 31 { 0 } else { self.x[n as usize] }
+    }
+    fn set_x(&mut self, n: u32, v: u64) {
+        if n != 31 {
+            self.x[n as usize] = v;
+        }
+    }
+    fn sp(&self) -> u64 {
+        0
+    }
+    fn set_sp(&mut self, _: u64) {}
+    fn v(&self, n: u32) -> u128 {
+        self.v[n as usize]
+    }
+    fn set_v(&mut self, n: u32, v: u128) {
+        self.v[n as usize] = v;
+    }
+    fn nzcv(&self) -> u64 {
+        0
+    }
+    fn set_nzcv(&mut self, _: u64) {}
+    fn fpcr(&self) -> u64 {
+        self.fpcr
+    }
+    fn fpsr(&self) -> u64 {
+        self.fpsr
+    }
+    fn set_fpsr(&mut self, v: u64) {
+        self.fpsr = v;
+    }
+    fn load(&mut self, _: u64, _: u8) -> u64 {
+        unreachable!()
+    }
+    fn store(&mut self, _: u64, _: u8, _: u64) {
+        unreachable!()
+    }
+}
+
+struct Rng(u64);
+
+impl Rng {
+    fn next(&mut self) -> u64 {
+        self.0 ^= self.0 >> 12;
+        self.0 ^= self.0 << 25;
+        self.0 ^= self.0 >> 27;
+        self.0.wrapping_mul(0x2545_f491_4f6c_dd1d)
+    }
+    fn lane(&mut self) -> u64 {
+        let r = self.next();
+        let special = [0, 0x8000_0000, 0x7f80_0000, 0xff80_0000, 0x7fc0_0000, 0x7f80_0001, 1, 0x3f80_0000, 0xffff_ffff, 0x7fff_ffff, 0x80, 5];
+        match r % 4 {
+            0 => special[(r >> 8) as usize % special.len()],
+            1 => (r >> 16) & 0xffff_ffff,
+            2 => ((r >> 20) % 0x60 + 0x40) << 23 | (r >> 32) & 0x7f_ffff | (r >> 63) << 31,
+            _ => (r >> 40) % 300,
+        }
+    }
+    fn state(&mut self) -> State {
+        let mut s = State { x: [0; 32], v: [0; 32], fpcr: [0, 0, 1 << 24, 3 << 22][(self.next() % 4) as usize], fpsr: 0 };
+        for i in 0..32 {
+            s.x[i] = self.next();
+            let l: Vec<u64> = (0..4).map(|_| self.lane()).collect();
+            s.v[i] = (l[0] | l[1] << 32) as u128 | ((l[2] | l[3] << 32) as u128) << 64;
+        }
+        s
+    }
+}
+
+/// Register-only forms from the game's hot list plus random words of each lifted form.
+const HOT: &[u32] = &[
+    0x6e60_28c6, 0x4eb1_b8c6, 0x6ea0_28c6, 0x4f2c_0423, 0x2e30_3a31, 0x4e20_5a31, 0x6e20_2a06, 0x2e23_fc41, 0x4eb1_fe52, 0x6ea1_d8f0,
+    0x6e20_5a72, 0x4ea4_34e7, 0x6e21_d800, 0x0ea0_a400, 0x4f21_0463, 0x6f3f_0606, 0x4e61_4401, 0x0ea7_acc6, 0x4f03_f600, 0x4e21_d800,
+    0x4f03_d7ea, 0x4ea1_b800, 0x6e30_fce7, 0x6f18_1486, 0x4e66_9627, 0x7e30_d844, 0x6e23_fc00, 0x0ea1_ac21, 0x0e20_5800, 0x2e30_3800,
+];
+const FORMS: &[(u32, u32)] = &[
+    (0x0e20_5800, 0x6000_03ff),
+    (0x2e20_2800, 0x40c0_03ff),
+    (0x0e20_b800, 0x60c0_03ff),
+    (0x0e21_d800, 0x6040_03ff),
+    (0x0ea1_b800, 0x6040_03ff),
+    (0x0ea1_d800, 0x6000_03ff),
+    (0x2e30_3800, 0x40c0_03ff),
+    (0x0e31_b800, 0x40c0_03ff),
+    (0x0e20_6400, 0x60df_0bff),
+    (0x0e20_a400, 0x60df_0bff),
+    (0x0e20_3400, 0x60df_0bff),
+    (0x0e20_8c00, 0x60df_03ff),
+    (0x0e20_9400, 0x60df_0bff),
+    (0x0e20_4400, 0x60df_03ff),
+    (0x2e20_fc00, 0x40df_03ff),
+    (0x2ea0_d400, 0x40df_03ff),
+    (0x0e20_fc00, 0x40df_03ff),
+    (0x0f00_0400, 0x607f_13ff),
+    (0x0f00_0400, 0x6007_f3ff),
+    (0x7e30_d800, 0x0040_03ff),
+];
+
+fn compile(words: &[u32]) -> Vec<extern "C" fn(*mut u64)> {
+    let mut b = JITBuilder::with_isa(host_isa().unwrap(), cranelift_module::default_libcall_names());
+    for (name, ptr) in abi::helpers() {
+        b.symbol(name, ptr);
+    }
+    let mut c = Compiler::new(JITModule::new(b)).unwrap();
+    let entries: BTreeSet<u64> = (0..words.len() as u64).map(|i| 0x1000 + 8 * i).collect();
+    let mut ids = Vec::new();
+    for (i, &w) in words.iter().enumerate() {
+        let addr = 0x1000 + 8 * i as u64;
+        let mut stmts = kirikae_a64::lift(addr, w).stmts;
+        assert!(!stmts.iter().any(|s| matches!(s, Stmt::Simd(_) | Stmt::Undefined(_))), "{w:08x} is not lifted");
+        stmts.push(Stmt::Return(kirikae_a64::Expr::Const(0)));
+        let f = Function { entry: addr, blocks: vec![Block { start: addr, insns: vec![Insn { addr, word: w, stmts }], next: addr + 4 }] };
+        ids.push(c.compile(&f, &entries).unwrap());
+    }
+    c.module.finalize_definitions().unwrap();
+    let fns = ids.into_iter().map(|id| unsafe { std::mem::transmute::<*const u8, extern "C" fn(*mut u64)>(c.module.get_finalized_function(id)) }).collect();
+    std::mem::forget(c);
+    fns
+}
+
+#[test]
+fn compiled_vector_instructions_match_the_interpreter() {
+    let mut rng = Rng(0xc1f_0e0e_5eed);
+    let mut words: Vec<u32> = HOT.to_vec();
+    for &(base, random) in FORMS {
+        let mut n = 0;
+        while n < 60 {
+            let w = base | (rng.next() as u32 & random);
+            let insn = kirikae_a64::lift(0, w);
+            if kirikae_a64::simd::supported(w) && !insn.stmts.iter().any(|s| matches!(s, Stmt::Simd(_) | Stmt::Undefined(_))) {
+                words.push(w);
+                n += 1;
+            }
+        }
+    }
+    let fns = compile(&words);
+    let mut cpu = vec![0u64; 2048];
+    for (&w, f) in words.iter().zip(&fns) {
+        for _ in 0..8 {
+            let start = rng.state();
+            let mut want = start.clone();
+            assert!(kirikae_a64::simd::exec(&mut want, w), "{w:08x}");
+            for k in 0..31 {
+                cpu[abi::OFF_X / 8 + k] = start.x[k];
+            }
+            for k in 0..32 {
+                cpu[abi::OFF_V / 8 + 2 * k] = start.v[k] as u64;
+                cpu[abi::OFF_V / 8 + 2 * k + 1] = (start.v[k] >> 64) as u64;
+            }
+            cpu[abi::OFF_FPCR / 8] = start.fpcr;
+            f(cpu.as_mut_ptr());
+            for k in 0..32 {
+                let got = cpu[abi::OFF_V / 8 + 2 * k] as u128 | (cpu[abi::OFF_V / 8 + 2 * k + 1] as u128) << 64;
+                assert_eq!(got, want.v[k], "{w:08x}: v{k} (fpcr {:x}) from {:x}", start.fpcr, start.v[k]);
+            }
+        }
+    }
+}
