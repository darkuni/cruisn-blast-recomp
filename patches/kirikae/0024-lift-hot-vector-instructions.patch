index 0000000..0470da5
--- /dev/null
+++ b/crates/a64/examples/simd_coverage.rs
@@ -0,0 +1,21 @@
+fn main() {
+    let path = std::env::args().nth(1).unwrap();
+    let (mut total, mut covered) = (0u64, 0u64);
+    let mut left: Vec<(u64, u32)> = Vec::new();
+    for line in std::fs::read_to_string(path).unwrap().lines() {
+        let mut it = line.split_whitespace();
+        let w = u32::from_str_radix(it.next().unwrap(), 16).unwrap();
+        let n: u64 = it.next().unwrap().parse().unwrap();
+        total += n;
+        let insn = kirikae_a64::lift::lift(0, w);
+        if insn.stmts.iter().any(|s| matches!(s, kirikae_a64::ir::Stmt::Simd(_))) {
+            left.push((n, w));
+        } else {
+            covered += n;
+        }
+    }
+    println!("covered {:.1}% of {} calls; {} words left", covered as f64 * 100.0 / total as f64, total, left.len());
+    for (n, w) in left.iter().take(40) {
+        println!("{n:>11} {w:08x}");
+    }
+}
