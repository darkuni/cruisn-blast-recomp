@@ -0,0 +1,62 @@
+//! Environment variables for the game's libc `getenv`.
+//!
+//! A Switch game sees no environment. Some of its libraries still read one: IL2CPP's Boehm
+//! garbage collector takes GC_FREE_SPACE_DIVISOR, GC_INITIAL_HEAP_SIZE, GC_PRINT_STATS and
+//! friends from it. The values come from the `[game_environment]` section of the settings file
+//! (and KIRIKAE_GUEST_ENV="NAME=VALUE;NAME=VALUE", which wins).
+
+use std::collections::BTreeMap;
+use std::sync::Arc;
+
+use crate::cpu::Cpu;
+use crate::mem::{perm, state};
+use crate::process::Process;
+
+/// Guest page holding the value strings (inside the address space, marked used).
+const STRINGS: u64 = 0x7f_fe00_0000;
+const STRINGS_SIZE: u64 = 0x10000;
+
+pub fn values() -> BTreeMap<String, String> {
+    let mut env = crate::settings::environment();
+    if let Ok(extra) = std::env::var("KIRIKAE_GUEST_ENV") {
+        for kv in extra.split(';') {
+            if let Some((k, v)) = kv.split_once('=') {
+                env.insert(k.trim().to_string(), v.trim().to_string());
+            }
+        }
+    }
+    env
+}
+
+pub fn install(p: &'static Process) {
+    let env = values();
+    let Some(&(addr, _)) = p.symbols.iter().find(|(_, n)| n == "getenv") else { return };
+    if env.is_empty() {
+        return;
+    }
+    if p.memory.map_as(STRINGS, STRINGS_SIZE, state::NORMAL, perm::R).is_err() {
+        p.warn_once("env: cannot map the string page; getenv left alone".to_string());
+        return;
+    }
+    let mut at = STRINGS;
+    let mut table: Vec<(String, u64)> = Vec::new();
+    for (k, v) in &env {
+        let bytes = [v.as_bytes(), &[0]].concat();
+        if at + bytes.len() as u64 > STRINGS + STRINGS_SIZE {
+            break;
+        }
+        p.memory.write(at, &bytes);
+        table.push((k.clone(), at));
+        at += bytes.len() as u64;
+    }
+    eprintln!("kirikae: game environment: {}", env.iter().map(|(k, v)| format!("{k}={v}")).collect::<Vec<_>>().join(" "));
+    let table = Arc::new(table);
+    p.hle.replace(
+        addr,
+        Arc::new(move |c: &mut Cpu| {
+            let name = crate::hle::guest_str(c, c.x[0]);
+            c.x[0] = table.iter().find(|(k, _)| *k == name).map_or(0, |(_, a)| *a);
+            c.pc = c.x[30];
+        }),
+    );
+}
