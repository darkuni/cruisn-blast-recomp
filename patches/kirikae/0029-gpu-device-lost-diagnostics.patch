diff --git a/crates/rt/src/gpu/vulkan/diag.rs b/crates/rt/src/gpu/vulkan/diag.rs
new file mode 100644
index 0000000..4ca32b6
--- /dev/null
+++ b/crates/rt/src/gpu/vulkan/diag.rs
@@ -0,0 +1,122 @@
+//! What the GPU was doing when the driver gives up (VK_ERROR_DEVICE_LOST).
+//!
+//! - VK_EXT_device_fault (when the driver has it): the driver's own description of the fault and
+//!   the GPU addresses involved. Free until something goes wrong, so always enabled.
+//! - VK_NV_device_diagnostic_checkpoints with KIRIKAE_GPU_DIAG=1: a marker before every draw,
+//!   dispatch and render pass, and on a loss the last markers the GPU reached, with what each one
+//!   was (shader addresses, counts). Costs a little per draw, so only on request.
+//!
+//! On a loss the report goes to the log and the game closes with a message instead of a panic.
+
+use std::collections::VecDeque;
+use std::ffi::{CStr, c_void};
+use std::sync::Mutex;
+
+use ash::vk;
+
+use super::Renderer;
+
+/// Markers kept for the report: enough to cover the batches in flight.
+const KEPT: usize = 1 << 16;
+
+pub(super) struct Diag {
+    pub(super) fault: Option<ash::ext::device_fault::Device>,
+    pub(super) checkpoints: Option<ash::nv::device_diagnostic_checkpoints::Device>,
+}
+
+struct Marks {
+    next: u64,
+    texts: VecDeque<(u64, String)>,
+}
+
+static MARKS: Mutex<Marks> = Mutex::new(Marks { next: 1, texts: VecDeque::new() });
+
+pub(super) fn wanted_checkpoints() -> bool {
+    crate::env_var!("KIRIKAE_GPU_DIAG").is_some_and(|v| v != "0")
+}
+
+impl Renderer {
+    /// A checkpoint before the next command: `what` is only built when checkpoints are on.
+    pub(super) fn mark(&self, what: impl FnOnce() -> String) {
+        let Some(cp) = self.diag.checkpoints.as_ref() else { return };
+        let id = {
+            let mut m = MARKS.lock().unwrap();
+            let id = m.next;
+            m.next += 1;
+            if m.texts.len() == KEPT {
+                m.texts.pop_front();
+            }
+            m.texts.push_back((id, what()));
+            id
+        };
+        unsafe { cp.cmd_set_checkpoint(self.cmd, id as usize as *const c_void) };
+    }
+
+    /// Report a lost device and close the game. `during`: what the renderer was doing.
+    pub(super) fn device_lost(&self, during: &str, err: vk::Result) -> ! {
+        eprintln!("kirikae: GPU: {err:?} during {during}: the graphics driver stopped the GPU");
+        self.report_fault();
+        self.report_checkpoints();
+        let _ = std::io::Write::flush(&mut std::io::stderr());
+        crate::launch::fail(
+            "The graphics driver stopped responding (Vulkan device lost) and the game has to close.\n\n\
+             The details are in the .log file next to the game: please send it in.",
+        )
+    }
+
+    fn report_fault(&self) {
+        let Some(f) = self.diag.fault.as_ref() else {
+            eprintln!("kirikae: GPU: this driver has no fault report (VK_EXT_device_fault)");
+            return;
+        };
+        let get = f.fp().get_device_fault_info_ext;
+        let mut counts = vk::DeviceFaultCountsEXT::default();
+        let r = unsafe { get(self.device.handle(), &mut counts, std::ptr::null_mut()) };
+        if r != vk::Result::SUCCESS && r != vk::Result::INCOMPLETE {
+            eprintln!("kirikae: GPU: no fault report ({r:?})");
+            return;
+        }
+        let mut addresses = vec![vk::DeviceFaultAddressInfoEXT::default(); counts.address_info_count as usize];
+        let mut vendor = vec![vk::DeviceFaultVendorInfoEXT::default(); counts.vendor_info_count as usize];
+        counts.vendor_binary_size = 0;
+        let mut info = vk::DeviceFaultInfoEXT::default();
+        info.p_address_infos = addresses.as_mut_ptr();
+        info.p_vendor_infos = vendor.as_mut_ptr();
+        let r = unsafe { get(self.device.handle(), &mut counts, &mut info) };
+        let text = |c: &[std::ffi::c_char]| unsafe { CStr::from_ptr(c.as_ptr()) }.to_string_lossy().into_owned();
+        eprintln!("kirikae: GPU fault ({r:?}): {}", text(&info.description));
+        for a in addresses.iter().take(counts.address_info_count as usize) {
+            let (lo, hi) = (a.reported_address & !(a.address_precision.max(1) - 1), a.reported_address | (a.address_precision.max(1) - 1));
+            eprintln!("kirikae: GPU fault address: {:?} at {:#x} (somewhere in {lo:#x}..={hi:#x})", a.address_type, a.reported_address);
+        }
+        for v in vendor.iter().take(counts.vendor_info_count as usize) {
+            eprintln!("kirikae: GPU fault vendor info: {} (code {:#x}, data {:#x})", text(&v.description), v.vendor_fault_code, v.vendor_fault_data);
+        }
+    }
+
+    fn report_checkpoints(&self) {
+        let Some(cp) = self.diag.checkpoints.as_ref() else {
+            eprintln!("kirikae: GPU: to see which draw the GPU was on, run the game again with KIRIKAE_GPU_DIAG=1");
+            return;
+        };
+        let n = unsafe { cp.get_queue_checkpoint_data_len(self.queue) };
+        let mut data = vec![vk::CheckpointDataNV::default(); n];
+        unsafe { cp.get_queue_checkpoint_data(self.queue, &mut data) };
+        let m = MARKS.lock().unwrap();
+        let first = m.texts.front().map_or(0, |t| t.0);
+        let text = |id: u64| if id >= first { m.texts.get((id - first) as usize).map(|t| t.1.as_str()) } else { None };
+        // Earliest marker still running per stage: the GPU had reached it but not finished the work after it.
+        let mut ids: Vec<(u64, vk::PipelineStageFlags)> = data.iter().map(|d| (d.p_checkpoint_marker as usize as u64, d.stage)).collect();
+        ids.sort_by_key(|&(id, _)| id);
+        eprintln!("kirikae: GPU checkpoints reached ({} recorded, markers up to {}):", ids.len(), m.next - 1);
+        for (id, stage) in &ids {
+            eprintln!("kirikae: GPU   #{id} {stage:?}: {}", text(*id).unwrap_or("(older than the markers kept)"));
+        }
+        if let Some(&(last, _)) = ids.iter().max_by_key(|(id, _)| *id) {
+            eprintln!("kirikae: GPU: the work right after the last marker reached:");
+            for id in last.saturating_sub(3)..=(last + 6).min(m.next - 1) {
+                eprintln!("kirikae: GPU   {}#{id}: {}", if id == last { "> " } else { "  " }, text(id).unwrap_or("?"));
+            }
+        }
+    }
+}
