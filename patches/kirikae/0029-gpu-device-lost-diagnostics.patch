 mod draw;
 mod guest_writes;
 mod images;
@@ -40,6 +41,8 @@ use volumes::Volume;
 use lines::{Line, LineKey};
 
 pub struct Renderer {
+    /// Reports for a lost device (diag.rs).
+    diag: diag::Diag,
     entry: ash::Entry,
     instance: ash::Instance,
     device: ash::Device,
@@ -501,6 +504,23 @@ impl Renderer {
             "kirikae: shader compilation: {}",
             if use_gpl { if use_eds3_clamp { "pipeline libraries (ahead of time)" } else { "pipeline libraries, no dynamic depth clamp" } } else { "whole pipelines (no pipeline library support)" }
         );
+        // The driver's fault report on a lost device, and (KIRIKAE_GPU_DIAG=1) draw checkpoints.
+        let mut fault_features = vk::PhysicalDeviceFaultFeaturesEXT::default();
+        if has(ash::ext::device_fault::NAME) {
+            let mut f2 = vk::PhysicalDeviceFeatures2::default().push_next(&mut fault_features);
+            unsafe { instance.get_physical_device_features2(physical, &mut f2) };
+        }
+        let use_fault = fault_features.device_fault == vk::TRUE;
+        if use_fault {
+            extensions.push(ash::ext::device_fault::NAME.as_ptr());
+        }
+        let use_checkpoints = diag::wanted_checkpoints() && has(ash::nv::device_diagnostic_checkpoints::NAME);
+        if use_checkpoints {
+            extensions.push(ash::nv::device_diagnostic_checkpoints::NAME.as_ptr());
+            eprintln!("kirikae: GPU diagnostics: a checkpoint before every draw (KIRIKAE_GPU_DIAG)");
+        } else if diag::wanted_checkpoints() {
+            eprintln!("kirikae: GPU diagnostics: this driver has no checkpoints (VK_NV_device_diagnostic_checkpoints)");
+        }
         let swapchains = surfaces && has(ash::khr::swapchain::NAME);
         if swapchains {
             extensions.push(ash::khr::swapchain::NAME.as_ptr());
@@ -528,6 +548,10 @@ impl Renderer {
         if use_eds3_clamp {
             info = info.push_next(&mut eds3_enable);
         }
+        let mut fault_enable = vk::PhysicalDeviceFaultFeaturesEXT::default().device_fault(true);
+        if use_fault {
+            info = info.push_next(&mut fault_enable);
+        }
         let device = unsafe { instance.create_device(physical, &info, None)? };
         let queue = unsafe { device.get_device_queue(family, 0) };
         let push = push_supported.then(|| ash::khr::push_descriptor::Device::new(&instance, &device));
@@ -589,7 +613,12 @@ impl Renderer {
         let compiler = PipelineCompiler::new(&device, pipeline_cache);
