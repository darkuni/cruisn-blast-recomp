+//! Which flag-setting statements can skip materializing NZCV.
+//!
+//! A compare (`SetNzcv(FlagsAdd*/FlagsLogic*)`) whose flags are only used by conditions
+//! (`Cond(Nzcv, cc)`) and the carry (`Carry(Nzcv)`) inside its own block, and are dead when the
+//! block ends, is compiled to direct comparisons on its operands: the packed NZCV value is
+//! never built or stored. Flags are dead across calls and returns (the AArch64 procedure call
+//! standard does not preserve them); leaving the function any other way keeps them live.
+
+use std::collections::{HashMap, HashSet};
+
+use kirikae_a64::{Expr, Op, Stmt};
+
+use crate::Function;
+
+/// Statements (instruction address, statement index) whose flags never need to exist.
+pub fn fusable(f: &Function) -> HashSet<(u64, usize)> {
+    let index: HashMap<u64, usize> = f.blocks.iter().enumerate().map(|(i, b)| (b.start, i)).collect();
+    let n = f.blocks.len();
+
+    // Per block: successors inside the function, whether leaving keeps flags live, whether the
+    // block reads flags before writing them, and whether it writes them at all.
+    let mut succ: Vec<Vec<usize>> = vec![Vec::new(); n];
+    let mut exit_live = vec![false; n];
+    let mut reads_first = vec![false; n];
+    let mut writes = vec![false; n];
+    for (i, b) in f.blocks.iter().enumerate() {
+        let target = |t: u64, succ: &mut Vec<usize>, exit: &mut bool| match index.get(&t) {
+            Some(&j) => succ.push(j),
+            None => *exit = true,
+        };
+        let mut written = false;
+        let mut ends = false;
+        'scan: for insn in &b.insns {
+            for s in &insn.stmts {
+                let reads = stmt_reads(s);
+                if reads && !written {
+                    reads_first[i] = true;
+                }
+                match s {
+                    Stmt::SetNzcv(_) | Stmt::Simd(_) => written = true,
+                    Stmt::Call(_) | Stmt::CallIndirect(_) | Stmt::Return(_) => {
+                        // Flags are dead after a call (the callee's) and at a return.
+                        written = true;
+                        ends = true;
+                        break 'scan;
+                    }
+                    Stmt::Jump(t) => {
+                        target(*t, &mut succ[i], &mut exit_live[i]);
+                        ends = true;
+                        break 'scan;
+                    }
+                    Stmt::JumpIf(_, t) => {
+                        target(*t, &mut succ[i], &mut exit_live[i]);
+                        target(insn.next(), &mut succ[i], &mut exit_live[i]);
+                        ends = true;
+                        break 'scan;
+                    }
+                    Stmt::JumpIndirect(_) | Stmt::Undefined(_) => {
+                        exit_live[i] = true;
+                        ends = true;
+                        break 'scan;
+                    }
+                    _ => {}
+                }
+            }
+        }
+        if !ends {
+            target(b.next, &mut succ[i], &mut exit_live[i]);
+        }
+        writes[i] = written;
+    }
+
+    // live_in[b] = reads_first || (!writes && live_out); live_out = exit_live || any succ live_in.
+    let mut live_in = reads_first.clone();
+    loop {
+        let mut changed = false;
+        for i in (0..n).rev() {
+            let out = exit_live[i] || succ[i].iter().any(|&j| live_in[j]);
+            let v = reads_first[i] || (!writes[i] && out);
+            if v != live_in[i] {
+                live_in[i] = v;
+                changed = true;
+            }
+        }
+        if !changed {
+            break;
+        }
+    }
+    let live_out = |i: usize| exit_live[i] || succ[i].iter().any(|&j| live_in[j]);
+
+    let mut out = HashSet::new();
+    for (bi, b) in f.blocks.iter().enumerate() {
+        let stmts: Vec<(u64, usize, &Stmt)> =
+            b.insns.iter().flat_map(|insn| insn.stmts.iter().enumerate().map(move |(k, s)| (insn.addr, k, s))).collect();
+        for (pos, &(addr, k, s)) in stmts.iter().enumerate() {
+            let Stmt::SetNzcv(e) = s else { continue };
+            if !fusable_form(e) {
+                continue;
+            }
+            if window_ok(&stmts[pos + 1..], || live_out(bi)) {
+                out.insert((addr, k));
+            }
+        }
+    }
+    out
+}
+
+/// A flag computation the code generator can turn into direct comparisons.
+pub fn fusable_form(e: &Expr) -> bool {
+    matches!(e, Expr::Op(Op::FlagsAdd64 | Op::FlagsAdd32 | Op::FlagsLogic64 | Op::FlagsLogic32, _))
+}
+
+/// After a fusable SetNzcv: every use until the flags die is a condition or the carry.
+fn window_ok(rest: &[(u64, usize, &Stmt)], live_out: impl Fn() -> bool) -> bool {
+    for &(_, _, s) in rest {
+        if !only_condition_reads(s) {
+            return false;
+        }
+        match s {
+            Stmt::SetNzcv(_) | Stmt::Call(_) | Stmt::CallIndirect(_) | Stmt::Return(_) => return true,
+            Stmt::Simd(_) | Stmt::Svc(_) | Stmt::Undefined(_) | Stmt::JumpIndirect(_) => return false,
+            Stmt::Jump(_) | Stmt::JumpIf(..) => return !live_out(),
+            _ => {}
+        }
+    }
+    !live_out()
+}
+
+fn stmt_exprs(s: &Stmt) -> Vec<&Expr> {
+    match s {
+        Stmt::Let(_, e) | Stmt::SetReg(_, e) | Stmt::SetSp(e) | Stmt::SetNzcv(e) | Stmt::SetSysReg(_, e) => vec![e],
+        Stmt::SetV { value, .. } => vec![value],
+        Stmt::Store { addr, value, .. } => vec![addr, value],
+        Stmt::Monitor { addr, lo, hi } | Stmt::StoreExclusive { addr, lo, hi, .. } => vec![addr, lo, hi],
+        Stmt::JumpIf(e, _) | Stmt::JumpIndirect(e) | Stmt::CallIndirect(e) | Stmt::Return(e) => vec![e],
+        _ => vec![],
+    }
+}
+
+/// Does the statement read NZCV (in any form)? Svc and Simd count as reads.
+fn stmt_reads(s: &Stmt) -> bool {
+    matches!(s, Stmt::Svc(_) | Stmt::Simd(_) | Stmt::Undefined(_)) || stmt_exprs(s).iter().any(|e| reads_nzcv(e))
+}
+
+fn reads_nzcv(e: &Expr) -> bool {
+    match e {
+        Expr::Nzcv => true,
+        Expr::Op(_, args) => args.iter().any(reads_nzcv),
+        Expr::Load { addr, .. } => reads_nzcv(addr),
+        _ => false,
+    }
+}
+
+/// Every NZCV read in the statement is `Cond(Nzcv, const)` or `Carry(Nzcv)`.
+fn only_condition_reads(s: &Stmt) -> bool {
+    stmt_exprs(s).iter().all(|e| condition_reads(e))
+}
+
+fn condition_reads(e: &Expr) -> bool {
+    match e {
+        Expr::Nzcv => false,
+        Expr::Op(Op::Cond, args) if matches!(args.as_slice(), [Expr::Nzcv, Expr::Const(_)]) => true,
+        Expr::Op(Op::Carry, args) if matches!(args.as_slice(), [Expr::Nzcv]) => true,
+        Expr::Op(_, args) => args.iter().all(condition_reads),
+        Expr::Load { addr, .. } => condition_reads(addr),
+        _ => true,
+    }
+}
+
