+
+    #[test]
+    fn raw_flag_reads_and_indirect_exits_keep_flags() {
+        let raw = Function {
+            entry: 0x100,
+            blocks: vec![block(0x100, vec![insn(0x100, vec![cmp(), Stmt::SetReg(2, Expr::Nzcv)]), insn(0x104, vec![Stmt::Return(Expr::Reg(30))])])],
+        };
+        assert!(fusable(&raw).is_empty());
+        let indirect = Function {
+            entry: 0x100,
+            blocks: vec![block(0x100, vec![insn(0x100, vec![cmp()]), insn(0x104, vec![Stmt::JumpIndirect(Expr::Reg(3))])])],
+        };
+        assert!(fusable(&indirect).is_empty());
+        let outside = Function { entry: 0x100, blocks: vec![block(0x100, vec![insn(0x100, vec![cmp()]), insn(0x104, vec![Stmt::Jump(0x9000)])])] };
+        assert!(fusable(&outside).is_empty());
+    }
+
+    #[test]
+    fn a_call_or_a_new_compare_ends_the_flags() {
+        let f = Function {
+            entry: 0x100,
+            blocks: vec![
+                block(0x100, vec![insn(0x100, vec![cmp()]), insn(0x104, vec![Stmt::SetReg(1, cond(1))]), insn(0x108, vec![Stmt::Call(0x500)])]),
+                block(0x10c, vec![insn(0x10c, vec![cmp()]), insn(0x110, vec![Stmt::Return(Expr::Reg(30))])]),
+            ],
+        };
+        assert_eq!(fusable(&f), HashSet::from([(0x100, 0), (0x10c, 0)]));
+    }
+}
