index 0000000..3384ed7
--- /dev/null
+++ b/crates/recomp/tests/flag_fusion.rs
@@ -0,0 +1,316 @@
+use std::collections::BTreeSet;
+
+use cranelift_jit::{JITBuilder, JITModule};
+use cranelift_module::FuncId;
+use kirikae_a64::{Expr, Insn, Op, Stmt};
+use kirikae_recomp::clif::{Compiler, host_isa};
+use kirikae_recomp::{Block, Function};
+use kirikae_rt::abi;
+
+struct Rng(u64);
+
+impl Rng {
+    fn next(&mut self) -> u64 {
+        self.0 ^= self.0 >> 12;
+        self.0 ^= self.0 << 25;
+        self.0 ^= self.0 >> 27;
+        self.0.wrapping_mul(0x2545_f491_4f6c_dd1d)
+    }
+
+    fn below(&mut self, n: u64) -> u64 {
+        self.next() % n
+    }
+}
+
+const COUNTER: u8 = 28;
+const REGS: u64 = 8;
+const CALLEE: u64 = 0x1000_0000;
+const OUTSIDE: u64 = 0x2000_0000;
+const MEM_BYTES: usize = 4096;
+
+fn c(v: u64) -> Expr {
+    Expr::Const(v)
+}
+
+fn op(o: Op, args: Vec<Expr>) -> Expr {
+    Expr::Op(o, args)
+}
+
+fn reg(r: &mut Rng) -> Expr {
+    Expr::Reg(r.below(REGS) as u8)
+}
+
+/// Operands that hit signed, unsigned and overflow edges.
+fn operand(r: &mut Rng) -> Expr {
+    match r.below(6) {
+        0 => c([
+            0,
+            1,
+            u64::MAX,
+            1 << 63,
+            (1 << 63) - 1,
+            0x7fff_ffff,
+            0x8000_0000,
+            0xffff_ffff,
+            0x1_0000_0000,
+        ][r.below(9) as usize]),
+        1 => c(r.below(8)),
+        _ => reg(r),
+    }
+}
+
+fn flags(r: &mut Rng) -> Stmt {
+    let (a, b) = (operand(r), operand(r));
+    let narrow = r.below(2) == 0;
+    let add = if narrow {
+        Op::FlagsAdd32
+    } else {
+        Op::FlagsAdd64
+    };
+    let logic = if narrow {
+        Op::FlagsLogic32
+    } else {
+        Op::FlagsLogic64
+    };
+    Stmt::SetNzcv(match r.below(5) {
+        0 | 1 => op(add, vec![a, op(Op::Not, vec![b]), c(1)]),
+        2 => op(add, vec![a, b, c(0)]),
+        3 => op(add, vec![a, b, op(Op::Carry, vec![Expr::Nzcv])]),
+        _ => op(logic, vec![op(Op::And, vec![a, b])]),
+    })
+}
+
+fn cond(r: &mut Rng) -> Expr {
+    op(Op::Cond, vec![Expr::Nzcv, c(r.below(16))])
+}
+
+fn body(r: &mut Rng) -> Vec<Stmt> {
+    let mut out = Vec::new();
+    for _ in 0..1 + r.below(3) {
+        out.push(match r.below(10) {
+            0..=3 => flags(r),
+            4 | 5 => Stmt::SetReg(
+                r.below(REGS) as u8,
+                op(Op::Select, vec![cond(r), operand(r), operand(r)]),
+            ),
+            6 => Stmt::SetReg(
+                r.below(REGS) as u8,
+                op(Op::Add, vec![reg(r), op(Op::Carry, vec![Expr::Nzcv])]),
+            ),
+            7 if r.below(3) == 0 => Stmt::SetReg(r.below(REGS) as u8, Expr::Nzcv),
+            8 => Stmt::SetNzcv(op(
+                Op::Select,
+                vec![
+                    cond(r),
+                    c(0x6000_0000),
+                    op(Op::FlagsAdd64, vec![reg(r), reg(r), c(0)]),
+                ],
+            )),
+            _ => Stmt::SetReg(r.below(REGS) as u8, op(Op::Add, vec![reg(r), operand(r)])),
+        });
+    }
+    out
+}
+
+fn random_function(r: &mut Rng, entry: u64) -> Function {
+    let n = 2 + r.below(7) as usize;
+    let lens: Vec<u64> = (0..n).map(|_| 1 + r.below(5)).collect();
+    let mut starts = vec![entry];
+    for len in &lens {
+        starts.push(starts.last().unwrap() + 4 * len + 4);
+    }
+    let mut blocks = Vec::new();
+    for i in 0..n {
+        let start = starts[i];
+        let alive = op(Op::Ne, vec![Expr::Reg(COUNTER), c(0)]);
+        let decrement = Stmt::SetReg(COUNTER, op(Op::Sub, vec![Expr::Reg(COUNTER), alive]));
+        let mut insns = vec![Insn {
+            addr: start,
+            word: 0,
+            stmts: vec![decrement],
+        }];
+        for k in 0..lens[i] {
+            insns.push(Insn {
+                addr: start + 4 + 4 * k,
+                word: 0,
+                stmts: body(r),
+            });
+        }
+        let last = insns.last_mut().unwrap();
+        let next = last.addr + 4;
+        let any = r.below(n as u64) as usize;
+        let forward = starts[(i + 1 + r.below((n - i) as u64) as usize).min(n - 1)];
+        if i == n - 1 {
+            last.stmts.push(Stmt::Return(Expr::Reg(30)));
+        } else {
+            match r.below(8) {
+                0..=3 => {
+                    let alive = op(Op::Ne, vec![Expr::Reg(COUNTER), c(0)]);
+                    let cc = cond(r);
+                    let cc = if starts[any] <= start {
+                        op(Op::And, vec![cc, alive])
+                    } else {
+                        cc
+                    };
+                    last.stmts.push(Stmt::JumpIf(cc, starts[any]));
+                }
+                4 => last.stmts.push(Stmt::Jump(forward)),
+                5 if r.below(3) == 0 => last.stmts.push(Stmt::JumpIf(cond(r), OUTSIDE)),
+                6 => {
+                    last.stmts.push(Stmt::SetReg(30, c(next)));
+                    last.stmts.push(Stmt::Call(CALLEE));
+                }
+                _ => {}
+            }
+        }
+        blocks.push(Block {
+            start,
+            insns,
+            next: starts[i + 1],
+        });
+    }
+    Function { entry, blocks }
+}
+
+fn callee() -> Function {
+    let stmts = vec![
+        Stmt::SetReg(
+            0,
+            op(
+                Op::Add,
+                vec![op(Op::Mul, vec![Expr::Reg(0), c(3)]), Expr::Reg(1)],
+            ),
+        ),
+        Stmt::SetReg(2, op(Op::Xor, vec![Expr::Reg(2), Expr::Sp])),
+        Stmt::SetV {
+            reg: 1,
+            hi: true,
+            value: op(Op::Add, vec![Expr::V { reg: 1, hi: false }, c(5)]),
+        },
+        Stmt::SetNzcv(c(0x6000_0000)),
+        Stmt::SetSp(op(Op::Sub, vec![Expr::Sp, c(16)])),
+        Stmt::Return(Expr::Reg(30)),
+    ];
+    Function {
+        entry: CALLEE,
+        blocks: vec![Block {
+            start: CALLEE,
+            insns: vec![Insn {
+                addr: CALLEE,
+                word: 0,
+                stmts,
+            }],
+            next: CALLEE + 4,
+        }],
+    }
+}
+
+fn jit(fast_regs: bool) -> Compiler<JITModule> {
+    let mut b = JITBuilder::with_isa(
+        host_isa().unwrap(),
+        cranelift_module::default_libcall_names(),
+    );
+    for (name, ptr) in abi::helpers() {
+        b.symbol(name, ptr);
+    }
+    let mut c = Compiler::new(JITModule::new(b)).unwrap();
+    c.set_fast_regs(fast_regs);
+    c
+}
+
+struct State {
+    cpu: Vec<u64>,
+    mem: Vec<u8>,
+}
+
+impl State {
+    fn new(r: &mut Rng) -> State {
+        let mut cpu = vec![0u64; 512];
+        for v in &mut cpu[abi::OFF_X / 8..abi::OFF_NZCV / 8 + 1] {
+            *v = r.next();
+        }
+        cpu[abi::OFF_NZCV / 8] &= 0xf000_0000;
+        cpu[abi::OFF_X / 8 + COUNTER as usize] = 12;
+        cpu[abi::OFF_X / 8 + 30] = 0xdead_0000;
+        let mem = (0..MEM_BYTES).map(|_| r.next() as u8).collect();
+        State { cpu, mem }
+    }
+
+    fn run(&mut self, f: extern "C" fn(*mut u64)) {
+        let base = self.cpu.as_mut_ptr() as *mut u8;
+        // SAFETY: the offsets are inside the 4 KiB buffer.
+        unsafe {
+            (base.add(abi::OFF_MEM) as *mut *mut u8).write_unaligned(self.mem.as_mut_ptr());
+            (base.add(abi::OFF_BUDGET) as *mut u32).write_unaligned(1 << 30);
+            base.add(abi::OFF_HALTED).write(0);
+        }
+        f(self.cpu.as_mut_ptr());
+    }
+
+    fn observed(&self) -> (Vec<u64>, Vec<u8>) {
+        (
+            self.cpu[abi::OFF_X / 8..abi::OFF_NZCV / 8 + 2].to_vec(),
+            self.mem.clone(),
+        )
+    }
+}
+
+fn jit_fused(fuse: bool) -> Compiler<JITModule> {
+    let mut c = jit(true);
+    c.set_fuse_flags(fuse);
+    c
+}
+
+#[test]
+fn fused_flags_match_materialized_flags() {
+    let mut r = Rng(0xf1a6_5eed_0042);
+    let funcs: Vec<Function> = (0..600)
+        .map(|i| random_function(&mut r, 0x1000 + 0x1000 * i))
+        .collect();
+    let mut entries: BTreeSet<u64> = funcs.iter().map(|f| f.entry).collect();
+    entries.insert(CALLEE);
+    let fused_count: usize = funcs
+        .iter()
+        .map(|f| kirikae_recomp::flags::fusable(f).len())
+        .sum();
+    assert!(fused_count > 500, "only {fused_count} compares fused");
+
+    let compile = |fuse| {
+        let mut c = jit_fused(fuse);
+        c.compile(&callee(), &entries).unwrap();
+        let ids: Vec<FuncId> = funcs
+            .iter()
+            .map(|f| c.compile(f, &entries).unwrap())
+            .collect();
+        c.module.finalize_definitions().unwrap();
+        let ptrs: Vec<extern "C" fn(*mut u64)> = ids
+            .iter()
+            .map(|id| unsafe { std::mem::transmute(c.module.get_finalized_function(*id)) })
+            .collect();
+        (c, ptrs)
+    };
+    let (_plain_module, plain) = compile(false);
+    let (_fused_module, fused) = compile(true);
+
+    for (i, f) in funcs.iter().enumerate() {
+        for run in 0..6 {
+            let mut a = State::new(&mut r);
+            let mut b = State {
+                cpu: a.cpu.clone(),
+                mem: a.mem.clone(),
+            };
+            a.run(plain[i]);
+            b.run(fused[i]);
+            // Everything but NZCV itself, which fused code leaves stale once the flags are dead.
+            let (mut x, ma) = a.observed();
+            let (mut y, mb) = b.observed();
+            let nz = (abi::OFF_NZCV - abi::OFF_X) / 8;
+            x[nz] = 0;
+            y[nz] = 0;
+            assert!(
+                x == y && ma == mb,
+                "function {i} run {run} differs:\n{f:#x?}"
+            );
+        }
+    }
+}
