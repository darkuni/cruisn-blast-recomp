+/// Per-thread time at the last present (prof categories), for slow frames.
+static THREAD_MARK: std::sync::Mutex<Vec<(String, [u64; crate::prof::CATS])>> = std::sync::Mutex::new(Vec::new());
+
+fn thread_report(slow: bool) -> Option<String> {
+    if !crate::prof::on() {
+        return None;
+    }
+    let now: Vec<(String, [u64; crate::prof::CATS])> = crate::prof::snapshot().into_iter().map(|(n, ns, _, _)| (n, ns)).collect();
+    let mut mark = THREAD_MARK.lock().unwrap();
+    let report = slow.then(|| {
+        let mut busy: Vec<(u64, String)> = now
+            .iter()
+            .map(|(name, ns)| {
+                let before = mark.iter().find(|(n, _)| n == name).map(|m| m.1).unwrap_or([0; crate::prof::CATS]);
+                let d: Vec<u64> = (0..crate::prof::CATS).map(|i| ns[i].saturating_sub(before[i])).collect();
+                // everything but blocked/sleep: the thread was doing or waiting on work
+                let active: u64 = (0..crate::prof::CATS).filter(|&i| i != crate::prof::Cat::Blocked as usize && i != crate::prof::Cat::Sleep as usize).map(|i| d[i]).sum();
+                let parts: Vec<String> = (0..crate::prof::CATS).filter(|&i| d[i] >= 2_000_000).map(|i| format!("{} {}", crate::prof::NAMES[i], d[i] / 1_000_000)).collect();
+                (active, format!("{name}: {}", parts.join(", ")))
+            })
+            .collect();
+        busy.sort_by(|a, b| b.0.cmp(&a.0));
+        busy.into_iter().take(4).filter(|b| b.0 >= 2_000_000).map(|b| b.1).collect::<Vec<_>>().join("; ")
+    });
+    *mark = now;
+    report
+}
