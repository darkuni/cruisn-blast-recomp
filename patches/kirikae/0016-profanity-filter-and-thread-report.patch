new file mode 100644
index 0000000..c739519
--- /dev/null
+++ b/crates/rt/src/ngc.rs
@@ -0,0 +1,47 @@
+//! nn::ngc::ProfanityFilter without the system NG word list.
+//!
+//! The filter reads system data 0x0100000000000823, which a dump of the game does not have;
+//! with an empty archive the SDK aborts inside CheckProfanityWords (Cruis'n Blast checks the
+//! initials typed after a race). These replacements answer like a console whose word list
+//! matches nothing: every word is clean and nothing is masked.
+
+use std::sync::Arc;
+
+use crate::cpu::Cpu;
+use crate::process::Process;
+
+fn ok(c: &mut Cpu) {
+    c.x[0] = 0;
+    c.pc = c.x[30];
+}
+
+pub fn install(p: &'static Process) {
+    let mut installed = 0;
+    for (addr, name) in &p.symbols {
+        let f: crate::hle::HostFn = if name.starts_with("_ZN2nn3ngc15ProfanityFilter19CheckProfanityWordsEPj") {
+            // (this, u32* results, u32 region mask, const T** words, size_t count)
+            Arc::new(|c: &mut Cpu| {
+                let (results, count) = (c.x[1], c.x[4].min(4096));
+                if results != 0 {
+                    c.process().memory.write(results, &vec![0u8; 4 * count as usize]);
+                }
+                ok(c);
+            })
+        } else if name.starts_with("_ZN2nn3ngc15ProfanityFilter24MaskProfanityWordsInTextEPi") {
+            // (this, int* masked count, T* text, u32 region mask)
+            Arc::new(|c: &mut Cpu| {
+                if c.x[1] != 0 {
+                    c.process().memory.write(c.x[1], &0u32.to_le_bytes());
+                }
+                ok(c);
+            })
+        } else {
+            continue;
+        };
+        p.hle.replace(*addr, f);
+        installed += 1;
+    }
+    if installed > 0 {
+        p.warn_once(format!("ngc: profanity filter answers \"clean\" ({installed} entry points)"));
+    }
+}
