+    /// TLD (texel fetch), bound (0xdc38) or bindless (0xdd38). Fields per envytools gm107:
+    /// dim 29-30, array 28, mask 31-34, LOD mode bit 55 (0 lz, 1 ll), AOFFI 35, MS 50, CL 54.
+    /// A registers: [layer], coords. B registers: [handle], [lod], [offset], [sample].
+    /// Render targets are single-sample on the host, so the sample index is read and ignored:
+    /// a resolve averaging N identical fetches gives the right color.
+    fn tld(&mut self, pc: u32, i: &Insn) -> R {
+        let bindless = i.op.value == 0xdd38000000000000;
+        if i.bit(54) {
+            self.unsupported.push("tld (lod clamp)");
+            return Ok(());
+        }
+        let (slot, handle) = if bindless {
+            match self.bindless_handle(pc, i.rb()) {
+                Some((slot, word)) => (Some(slot), word),
+                None => {
+                    self.unsupported.push("tld (bindless)");
+                    return Ok(());
+                }
+            }
+        } else {
+            (None, i.bits(36, 13) as u32)
+        };
+        let dim = match i.bits(29, 2) {
+            0 => TexDim::D1,
+            1 => TexDim::D2,
+            2 => TexDim::D3,
+            _ => {
+                self.unsupported.push("tld (cube)");
+                return Ok(());
+            }
+        };
+        let array = i.bit(28);
+        let mut reg_a = i.ra();
+        let mut take_a = |t: &mut Self| -> R<Word> {
+            let r = reg_a;
+            if reg_a != RZ {
+                reg_a += 1;
+            }
+            t.r(r)
+        };
+        let layer = if array { Some(take_a(self)?) } else { None };
+        let mut coords = Vec::new();
+        for _ in 0..Self::coord_count(dim) {
+            coords.push(take_a(self)?);
+        }
+        let mut reg_b = if bindless && i.rb() != RZ { i.rb() + 1 } else { i.rb() };
+        let mut take_b = |t: &mut Self| -> R<Word> {
+            let r = reg_b;
+            if reg_b != RZ {
+                reg_b += 1;
+            }
+            t.r(r)
+        };
