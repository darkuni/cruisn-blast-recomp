+        let offset = if i.bit(35) { Some(take_b(self)?) } else { None };
+        if i.bit(50) {
+            let _sample = take_b(self)?;
+        }
+        let result = self.fetch(slot, handle, dim, array, coords, layer, lod, offset)?;
+        let mut reg = i.rd();
+        for (c, &value) in result.iter().enumerate() {
+            if i.bit(31 + c as u32) && reg != RZ {
+                self.set(reg, value)?;
+                reg += 1;
+            }
+        }
+        Ok(())
+    }
