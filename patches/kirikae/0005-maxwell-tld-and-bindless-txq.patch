+
+fn tld_b_2d(rd: u64, ra: u64, rb: u64, mask: u64, ms: bool) -> u64 {
+    0xdd38_0000_0000_0000 | (ms as u64) << 50 | mask << 31 | 1 << 29 | rb << 20 | PT | ra << 8 | rd
+}
+fn txq_b_dimension(rd: u64, ra: u64) -> u64 {
+    0xdf50_0000_0000_0000 | 0x3 << 31 | 1 << 22 | PT | ra << 8 | rd
+}
+
+#[test]
+fn bindless_texel_fetch_and_size_query_for_an_msaa_resolve() {
+    // The resolve shader pattern: handle = c2[0x168] | c2[0x568]; size via TXQ.B; then
+    // TLD.B .ms with the sample index in the register after the handle.
+    let code = program(
+        fragment_header(1),
+        &[
+            mov_cbuf(14, 2, 0x168),
+            mov32i(15, 0),
+            lop_or_cbuf(14, 14, 2, 0x568),
+            txq_b_dimension(0, 14),
+            mov32i(20, 3),
+            mov32i(21, 5),
+            mov_reg(6, 14),
+            mov32i(7, 1),
+            tld_b_2d(4, 20, 6, 0xf, true),
+            EXIT,
+        ],
+    );
+    let shader = translate(&code, &options(Stage::Fragment), &kirikae_maxwell::NoEnv).unwrap();
+    assert!(shader.unsupported.is_empty(), "{:?}", shader.unsupported);
+    assert_eq!(shader.textures.len(), 1, "query and fetch share one binding");
+    let t = shader.textures[0];
+    assert_eq!((t.slot, t.handle, t.or), (Some(2), 0x168 / 4, Some((2, 0x568 / 4))));
+    validate(&shader.spirv);
+}
+
+#[test]
+fn bound_texel_fetch() {
+    let code = program(fragment_header(1), &[mov32i(0, 1), mov32i(1, 2), 0xdc38_0000_0000_0000 | 5 << 36 | 0xf << 31 | 1 << 29 | 0xff << 20 | PT | 4, EXIT]);
+    let shader = translate(&code, &options(Stage::Fragment), &kirikae_maxwell::NoEnv).unwrap();
+    assert!(shader.unsupported.is_empty(), "{:?}", shader.unsupported);
+    assert_eq!((shader.textures[0].slot, shader.textures[0].handle), (None, 5));
+    validate(&shader.spirv);
+}
