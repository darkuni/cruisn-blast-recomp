+/// Destination rectangle (x, y, width, height) for a `w`x`h` frame in a `tw`x`th` window:
+/// the whole window, or the largest centered rectangle with the frame's aspect ratio.
+pub(super) fn fit(w: u32, h: u32, tw: u32, th: u32, keep_aspect: bool) -> (i32, i32, i32, i32) {
+    if !keep_aspect || w == 0 || h == 0 {
+        return (0, 0, tw as i32, th as i32);
+    }
+    let (w, h, tw64, th64) = (w as u64, h as u64, tw as u64, th as u64);
+    let (dw, dh) = if tw64 * h > th64 * w { ((th64 * w + h / 2) / h, th64) } else { (tw64, (tw64 * h + w / 2) / w) };
+    let (dw, dh) = (dw.clamp(1, tw64) as i32, dh.clamp(1, th64) as i32);
+    ((tw as i32 - dw) / 2, (th as i32 - dh) / 2, dw, dh)
+}
