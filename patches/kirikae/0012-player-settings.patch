+#[cfg(test)]
+mod fit_tests {
+    use super::fit;
+
+    #[test]
+    fn letterbox_and_pillarbox() {
+        assert_eq!(fit(1920, 1080, 1920, 1080, true), (0, 0, 1920, 1080));
+        assert_eq!(fit(1920, 1080, 3440, 1440, true), (440, 0, 2560, 1440));
+        assert_eq!(fit(1920, 1080, 1920, 1200, true), (0, 60, 1920, 1080));
+        assert_eq!(fit(1920, 1080, 3440, 1440, false), (0, 0, 3440, 1440));
+    }
+}
