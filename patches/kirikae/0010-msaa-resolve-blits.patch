+
+/// Sample grid of the 3D engine's MULTISAMPLE_MODE (method 0x574, byte offset 0x15d0;
+/// envytools g80_msaa_mode).
+pub(super) fn msaa_grid(regs: &[u32]) -> (u32, u32) {
+    match regs[0x574] & 0xf {
+        1 | 5 => (2, 1),
+        2 | 8 | 9 => (2, 2),
+        3 | 4 | 0xa | 0xb => (4, 2),
+        6 => (4, 4),
+        _ => (1, 1),
+    }
+}
