--- a/crates/a64/src/simd/mod.rs
+++ b/crates/a64/src/simd/mod.rs
@@ -3,6 +3,39 @@ pub mod fp;
 mod fpscalar;
 mod ldst;
 mod neon;
+
+/// Up to 16 lane values on the stack: the interpreter runs for every vector instruction the
+/// recompiler does not inline, so it must not allocate.
+#[derive(Clone, Copy)]
+pub(crate) struct Lanes {
+    buf: [u64; 16],
+    n: usize,
+}
+
+impl std::ops::Deref for Lanes {
+    type Target = [u64];
+    fn deref(&self) -> &[u64] {
+        &self.buf[..self.n]
+    }
+}
+
+impl std::ops::Index<usize> for Lanes {
+    type Output = u64;
+    fn index(&self, i: usize) -> &u64 {
+        &self.buf[..self.n][i]
+    }
+}
+
+impl FromIterator<u64> for Lanes {
+    fn from_iter<I: IntoIterator<Item = u64>>(it: I) -> Lanes {
+        let mut l = Lanes { buf: [0; 16], n: 0 };
+        for v in it {
+            l.buf[l.n] = v;
+            l.n += 1;
+        }
+        l
+    }
+}
