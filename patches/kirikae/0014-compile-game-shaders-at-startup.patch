index 0000000..df1ee09
--- /dev/null
+++ b/crates/rt/src/gpu/vulkan/gpl.rs
@@ -0,0 +1,645 @@
+//! Graphics pipeline libraries (VK_EXT_graphics_pipeline_library).
+//!
+//! Every pipeline is linked from four parts: vertex input, pre-rasterization (the vertex
+//! shader), fragment shader and fragment output. The two shader parts are the expensive ones
+//! and depend only on their own shader: vertex resources live in descriptor set 0 and fragment
+//! resources in set 1 (independent sets), and the viewport depth transform comes from a push
+//! constant instead of being baked into the vertex shader. So they can all be compiled up
+//! front from the game's shader programs (`<exe>.shaders`, written by the build), and a draw
+//! only has to link the parts, which is fast.
+
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+use std::sync::{Arc, Mutex};
+
+use ash::vk;
+use kirikae_maxwell::{NoEnv, Options, Shader, Stage};
+
+use super::Renderer;
+use super::descriptors::{FRAGMENT_BASE, IMAGE_OFFSET, STORAGE_OFFSET, TEXTURE_OFFSET, VERTEX_BASE};
+use super::pipeline::{LayoutKey, PipelineKey};
+use super::preload::spirv_hash;
+use crate::gpu::threed::CB_SLOTS;
+use crate::overlay::{PRELOAD_DONE, PRELOAD_TOTAL};
+
+/// Shader parts compiled ahead of time, compiled while the game ran, and pipelines linked.
+pub static PARTS_PRELOADED: AtomicUsize = AtomicUsize::new(0);
+pub static PARTS_ON_DEMAND: AtomicUsize = AtomicUsize::new(0);
+pub static LINKED: AtomicUsize = AtomicUsize::new(0);
+
+/// `{ f32 depth scale, f32 depth offset }` for the vertex stage.
+pub(super) const PUSH_SIZE: u32 = 8;
+
+type PreKey = (vk::ShaderModule, LayoutKey, bool);
+type FragKey = (vk::ShaderModule, LayoutKey, [u32; 2]);
+
+/// Resource bindings of one translated shader (same numbering as the draw path).
+pub(super) fn bindings_of(s: &Shader, base: u32) -> Vec<(u32, vk::DescriptorType)> {
+    let mut out = Vec::new();
+    for slot in 0..CB_SLOTS as u32 {
+        if s.cbufs >> slot & 1 == 1 {
+            out.push((base + slot, vk::DescriptorType::UNIFORM_BUFFER));
+        }
+    }
+    for slot in 0..16 {
+        if s.storage >> slot & 1 == 1 {
+            out.push((base + STORAGE_OFFSET + slot, vk::DescriptorType::STORAGE_BUFFER));
+        }
+    }
+    for t in &s.textures {
+        out.push((t.binding, vk::DescriptorType::SAMPLED_IMAGE));
+        out.push((t.binding + 1, vk::DescriptorType::SAMPLER));
+    }
+    for i in &s.images {
+        out.push((i.binding, vk::DescriptorType::STORAGE_IMAGE));
+    }
+    out
+}
+
+/// The set layout key for a stage's bindings (visible to that stage only, so the vertex and
+/// fragment sets never overlap).
+pub(super) fn set_key(mut bindings: Vec<(u32, vk::DescriptorType)>, stage: Stage) -> LayoutKey {
+    bindings.sort_unstable_by_key(|b| b.0);
+    bindings.dedup();
+    let flags = if stage == Stage::Fragment { vk::ShaderStageFlags::FRAGMENT } else { vk::ShaderStageFlags::VERTEX };
+    (bindings, flags.as_raw())
+}
+
+/// Translation options in library mode; the draw path and the preload must agree exactly so
+/// the same program gives the same SPIR-V.
+pub(super) fn options(stage: Stage) -> Options {
+    let base = if stage == Stage::Fragment { FRAGMENT_BASE } else { VERTEX_BASE };
+    Options {
+        texture_binding: base + TEXTURE_OFFSET,
+        storage_binding: base + STORAGE_OFFSET,
+        image_binding: base + IMAGE_OFFSET,
+        exact_texel_rounding: crate::env_var!("KIRIKAE_NO_TEXEL_ROUNDING").is_some(),
+        descriptor_set: (stage == Stage::Fragment) as u32,
+        depth_push: stage == Stage::Vertex,
+        ..Options::new(stage, base)
+    }
+}
+
+pub(super) fn dynamic_states(clamp: bool) -> Vec<vk::DynamicState> {
+    let mut d = vec![
+        vk::DynamicState::VIEWPORT,
+        vk::DynamicState::SCISSOR,
+        vk::DynamicState::CULL_MODE,
+        vk::DynamicState::FRONT_FACE,
+        vk::DynamicState::BLEND_CONSTANTS,
+        vk::DynamicState::DEPTH_TEST_ENABLE,
+        vk::DynamicState::DEPTH_WRITE_ENABLE,
+        vk::DynamicState::DEPTH_COMPARE_OP,
+        vk::DynamicState::STENCIL_TEST_ENABLE,
+        vk::DynamicState::STENCIL_OP,
+        vk::DynamicState::STENCIL_COMPARE_MASK,
+        vk::DynamicState::STENCIL_WRITE_MASK,
+        vk::DynamicState::STENCIL_REFERENCE,
+        vk::DynamicState::DEPTH_BIAS_ENABLE,
+        vk::DynamicState::DEPTH_BIAS,
+    ];
+    if clamp {
+        d.push(vk::DynamicState::DEPTH_CLAMP_ENABLE_EXT);
+    }
+    d
+}
+
+/// Parts shared with the preload threads.
+pub(super) struct Shared {
+    device: ash::Device,
+    cache: vk::PipelineCache,
+    /// Depth clamp is dynamic state (VK_EXT_extended_dynamic_state3).
+    pub(super) clamp_dynamic: bool,
+    set_layouts: Mutex<HashMap<LayoutKey, vk::DescriptorSetLayout>>,
+    lib_layouts: Mutex<HashMap<(Option<LayoutKey>, Option<LayoutKey>), vk::PipelineLayout>>,
+    pre: Mutex<HashMap<PreKey, vk::Pipeline>>,
+    frag: Mutex<HashMap<FragKey, vk::Pipeline>>,
+    /// Shader parts compiled while the game was running (not preloaded).
+    pub(super) on_demand: AtomicUsize,
+    pub(super) preloaded: AtomicUsize,
+}
+
+impl Shared {
+    /// Identity of a shader part: its SPIR-V hash, carried in a ShaderModule handle. The
+    /// real VkShaderModule only exists while its library compiles.
+    pub(super) fn id(&self, spirv: &[u32]) -> vk::ShaderModule {
+        use ash::vk::Handle;
+        vk::ShaderModule::from_raw(spirv_hash(spirv) | 1)
+    }
+
+    fn temp_module(&self, spirv: &[u32]) -> Result<vk::ShaderModule, vk::Result> {
+        unsafe { self.device.create_shader_module(&vk::ShaderModuleCreateInfo::default().code(spirv), None) }
+    }
+
+    pub(super) fn set_layout(&self, key: &LayoutKey) -> vk::DescriptorSetLayout {
+        let mut m = self.set_layouts.lock().unwrap();
+        if let Some(&l) = m.get(key) {
+            return l;
+        }
+        let stages = vk::ShaderStageFlags::from_raw(key.1);
+        let bindings: Vec<vk::DescriptorSetLayoutBinding> = key.0.iter().map(|&(b, ty)| vk::DescriptorSetLayoutBinding::default().binding(b).descriptor_type(ty).descriptor_count(1).stage_flags(stages)).collect();
+        let l = unsafe { self.device.create_descriptor_set_layout(&vk::DescriptorSetLayoutCreateInfo::default().bindings(&bindings), None).unwrap() };
+        m.insert(key.clone(), l);
+        l
+    }
+
+    /// Pipeline layout with independent sets: set 0 vertex, set 1 fragment.
+    pub(super) fn layout(&self, vertex: Option<&LayoutKey>, fragment: Option<&LayoutKey>) -> vk::PipelineLayout {
+        let key = (vertex.cloned(), fragment.cloned());
+        if let Some(&l) = self.lib_layouts.lock().unwrap().get(&key) {
+            return l;
+        }
+        let sets = [vertex.map_or(vk::DescriptorSetLayout::null(), |k| self.set_layout(k)), fragment.map_or(vk::DescriptorSetLayout::null(), |k| self.set_layout(k))];
+        let push = [vk::PushConstantRange { stage_flags: vk::ShaderStageFlags::VERTEX, offset: 0, size: PUSH_SIZE }];
+        let info = vk::PipelineLayoutCreateInfo::default().flags(vk::PipelineLayoutCreateFlags::INDEPENDENT_SETS_EXT).set_layouts(&sets).push_constant_ranges(&push);
+        let l = unsafe { self.device.create_pipeline_layout(&info, None).unwrap() };
+        *self.lib_layouts.lock().unwrap().entry(key).or_insert(l)
+    }
+
+    fn library(&self, info: vk::GraphicsPipelineCreateInfo, parts: vk::GraphicsPipelineLibraryFlagsEXT) -> Result<vk::Pipeline, vk::Result> {
+        let mut lib = vk::GraphicsPipelineLibraryCreateInfoEXT::default().flags(parts);
+        let info = info.flags(vk::PipelineCreateFlags::LIBRARY_KHR).push_next(&mut lib);
+        unsafe { self.device.create_graphics_pipelines(self.cache, &[info], None) }.map(|p| p[0]).map_err(|(_, e)| e)
+    }
+
+    /// The vertex shader part; `clamp` is ignored when depth clamp is dynamic.
+    pub(super) fn pre(&self, id: vk::ShaderModule, spirv: &[u32], set: &LayoutKey, clamp: bool, on_demand: bool) -> Result<vk::Pipeline, vk::Result> {
+        let clamp = clamp && !self.clamp_dynamic;
+        let key = (id, set.clone(), clamp);
+        if let Some(&p) = self.pre.lock().unwrap().get(&key) {
+            return Ok(p);
+        }
+        let module = self.temp_module(spirv)?;
+        let layout = self.layout(Some(set), None);
+        let stages = [vk::PipelineShaderStageCreateInfo::default().stage(vk::ShaderStageFlags::VERTEX).module(module).name(c"main")];
+        let viewport = vk::PipelineViewportStateCreateInfo::default().viewport_count(1).scissor_count(1);
+        let raster = vk::PipelineRasterizationStateCreateInfo::default().polygon_mode(vk::PolygonMode::FILL).line_width(1.0).depth_clamp_enable(clamp);
+        let dynamic = dynamic_states(self.clamp_dynamic);
+        let dynamic = vk::PipelineDynamicStateCreateInfo::default().dynamic_states(&dynamic);
+        let mut rendering = vk::PipelineRenderingCreateInfo::default();
+        let info = vk::GraphicsPipelineCreateInfo::default()
+            .stages(&stages)
+            .viewport_state(&viewport)
+            .rasterization_state(&raster)
+            .dynamic_state(&dynamic)
+            .layout(layout)
+            .push_next(&mut rendering);
+        let p = self.library(info, vk::GraphicsPipelineLibraryFlagsEXT::PRE_RASTERIZATION_SHADERS);
+        unsafe { self.device.destroy_shader_module(module, None) };
+        let p = p?;
+        self.count(on_demand);
+        Ok(*self.pre.lock().unwrap().entry(key).or_insert(p))
+    }
+
+    /// The fragment shader part (`module` null for depth-only draws).
+    pub(super) fn frag(&self, id: vk::ShaderModule, spirv: Option<&[u32]>, set: &LayoutKey, alpha_test: [u32; 2], on_demand: bool) -> Result<vk::Pipeline, vk::Result> {
+        let key = (id, set.clone(), alpha_test);
+        if let Some(&p) = self.frag.lock().unwrap().get(&key) {
+            return Ok(p);
+        }
+        let module = match spirv {
+            Some(code) => self.temp_module(code)?,
+            None => vk::ShaderModule::null(),
+        };
+        let layout = self.layout(None, Some(set));
+        let entries = [vk::SpecializationMapEntry { constant_id: 0, offset: 0, size: 4 }, vk::SpecializationMapEntry { constant_id: 1, offset: 4, size: 4 }];
+        let data: Vec<u8> = alpha_test.iter().flat_map(|w| w.to_ne_bytes()).collect();
+        let spec = vk::SpecializationInfo::default().map_entries(&entries).data(&data);
+        let stages: Vec<vk::PipelineShaderStageCreateInfo> = if module == vk::ShaderModule::null() {
+            Vec::new()
+        } else {
+            vec![vk::PipelineShaderStageCreateInfo::default().stage(vk::ShaderStageFlags::FRAGMENT).module(module).name(c"main").specialization_info(&spec)]
+        };
+        let depth = vk::PipelineDepthStencilStateCreateInfo::default().depth_compare_op(vk::CompareOp::LESS_OR_EQUAL);
+        let multisample = vk::PipelineMultisampleStateCreateInfo::default().rasterization_samples(vk::SampleCountFlags::TYPE_1);
+        let dynamic = dynamic_states(self.clamp_dynamic);
+        let dynamic = vk::PipelineDynamicStateCreateInfo::default().dynamic_states(&dynamic);
+        let mut rendering = vk::PipelineRenderingCreateInfo::default();
+        let info = vk::GraphicsPipelineCreateInfo::default()
+            .stages(&stages)
+            .depth_stencil_state(&depth)
+            .multisample_state(&multisample)
+            .dynamic_state(&dynamic)
+            .layout(layout)
+            .push_next(&mut rendering);
+        let p = self.library(info, vk::GraphicsPipelineLibraryFlagsEXT::FRAGMENT_SHADER);
+        if module != vk::ShaderModule::null() {
+            unsafe { self.device.destroy_shader_module(module, None) };
+        }
+        let p = p?;
+        self.count(on_demand);
+        Ok(*self.frag.lock().unwrap().entry(key).or_insert(p))
+    }
+
+    fn count(&self, on_demand: bool) {
+        if on_demand {
+            self.on_demand.fetch_add(1, Ordering::Relaxed);
+            PARTS_ON_DEMAND.fetch_add(1, Ordering::Relaxed);
+        } else {
+            self.preloaded.fetch_add(1, Ordering::Relaxed);
+            PARTS_PRELOADED.fetch_add(1, Ordering::Relaxed);
+        }
+    }
+
+    pub(super) fn vertex_input(&self, key: &PipelineKey) -> Result<vk::Pipeline, vk::Result> {
+        let bindings: Vec<vk::VertexInputBindingDescription> = key.bindings.iter().map(|&(b, stride)| vk::VertexInputBindingDescription { binding: b, stride, input_rate: vk::VertexInputRate::VERTEX }).collect();
+        let attributes: Vec<vk::VertexInputAttributeDescription> = key.attributes.iter().map(|&(location, binding, format, offset)| vk::VertexInputAttributeDescription { location, binding, format, offset }).collect();
+        let vertex_input = vk::PipelineVertexInputStateCreateInfo::default().vertex_binding_descriptions(&bindings).vertex_attribute_descriptions(&attributes);
+        let assembly = vk::PipelineInputAssemblyStateCreateInfo::default().topology(key.topology);
+        let dynamic = dynamic_states(self.clamp_dynamic);
+        let dynamic = vk::PipelineDynamicStateCreateInfo::default().dynamic_states(&dynamic);
+        let info = vk::GraphicsPipelineCreateInfo::default().vertex_input_state(&vertex_input).input_assembly_state(&assembly).dynamic_state(&dynamic);
+        self.library(info, vk::GraphicsPipelineLibraryFlagsEXT::VERTEX_INPUT_INTERFACE)
+    }
+
+    pub(super) fn fragment_output(&self, key: &PipelineKey) -> Result<vk::Pipeline, vk::Result> {
+        let attachments: Vec<vk::PipelineColorBlendAttachmentState> = key.blend.iter().map(|b| super::pipeline::blend_attachment(b)).collect();
+        let blend = vk::PipelineColorBlendStateCreateInfo::default().attachments(&attachments);
+        let multisample = vk::PipelineMultisampleStateCreateInfo::default().rasterization_samples(vk::SampleCountFlags::TYPE_1);
+        let dynamic = dynamic_states(self.clamp_dynamic);
+        let dynamic = vk::PipelineDynamicStateCreateInfo::default().dynamic_states(&dynamic);
+        let mut rendering = vk::PipelineRenderingCreateInfo::default().color_attachment_formats(&key.colors).depth_attachment_format(key.depth);
+        if super::images::aspect_of(key.depth).contains(vk::ImageAspectFlags::STENCIL) {
+            rendering = rendering.stencil_attachment_format(key.depth);
+        }
+        let info = vk::GraphicsPipelineCreateInfo::default().color_blend_state(&blend).multisample_state(&multisample).dynamic_state(&dynamic).push_next(&mut rendering);
+        self.library(info, vk::GraphicsPipelineLibraryFlagsEXT::FRAGMENT_OUTPUT_INTERFACE)
+    }
+
+    pub(super) fn link(&self, parts: &[vk::Pipeline; 4], layout: vk::PipelineLayout) -> Result<vk::Pipeline, vk::Result> {
+        let mut libs = vk::PipelineLibraryCreateInfoKHR::default().libraries(parts);
+        let info = vk::GraphicsPipelineCreateInfo::default().layout(layout).push_next(&mut libs);
+        unsafe { self.device.create_graphics_pipelines(self.cache, &[info], None) }.map(|p| p[0]).map_err(|(_, e)| e)
+    }
+
+    /// Everything this owns.
+    unsafe fn destroy(&self) {
+        unsafe {
+            let d = &self.device;
+            for p in self.pre.lock().unwrap().drain().map(|(_, p)| p).chain(self.frag.lock().unwrap().drain().map(|(_, p)| p)) {
+                d.destroy_pipeline(p, None);
+            }
+            for (_, l) in self.lib_layouts.lock().unwrap().drain() {
+                d.destroy_pipeline_layout(l, None);
+            }
+            for (_, l) in self.set_layouts.lock().unwrap().drain() {
+                d.destroy_descriptor_set_layout(l, None);
+            }
+        }
+    }
+}
+
+pub(super) struct Gpl {
+    pub(super) shared: Arc<Shared>,
+    pub(super) eds3: Option<ash::ext::extended_dynamic_state3::Device>,
+    vertex_inputs: HashMap<(Vec<(u32, u32, vk::Format, u32)>, Vec<(u32, u32)>, vk::PrimitiveTopology), vk::Pipeline>,
+    outputs: HashMap<(Vec<vk::Format>, vk::Format, Vec<[u32; 8]>), vk::Pipeline>,
+    /// link layout -> (vertex set key, fragment set key, set layouts)
+    pub(super) layouts: HashMap<vk::PipelineLayout, (LayoutKey, LayoutKey, [vk::DescriptorSetLayout; 2])>,
+    pub(super) links: usize,
+    stop: Arc<AtomicBool>,
+    workers: Vec<std::thread::JoinHandle<()>>,
+}
+
+impl Gpl {
+    pub(super) fn new(device: &ash::Device, cache: vk::PipelineCache, eds3: Option<ash::ext::extended_dynamic_state3::Device>) -> Gpl {
+        Gpl {
+            shared: Arc::new(Shared {
+                device: device.clone(),
+                cache,
+                clamp_dynamic: eds3.is_some(),
+                set_layouts: Default::default(),
+                lib_layouts: Default::default(),
+                pre: Default::default(),
+                frag: Default::default(),
+                on_demand: AtomicUsize::new(0),
+                preloaded: AtomicUsize::new(0),
+            }),
+            eds3,
+            vertex_inputs: HashMap::new(),
+            outputs: HashMap::new(),
+            layouts: HashMap::new(),
+            links: 0,
+            stop: Arc::new(AtomicBool::new(false)),
+            workers: Vec::new(),
+        }
+    }
+
+    /// The link layout for a vertex/fragment pair, and its two set layouts.
+    pub(super) fn link_layout(&mut self, vertex: LayoutKey, fragment: LayoutKey) -> (vk::PipelineLayout, [vk::DescriptorSetLayout; 2]) {
+        let layout = self.shared.layout(Some(&vertex), Some(&fragment));
+        if let Some(e) = self.layouts.get(&layout) {
+            return (layout, e.2);
+        }
+        let sets = [self.shared.set_layout(&vertex), self.shared.set_layout(&fragment)];
+        self.layouts.insert(layout, (vertex, fragment, sets));
+        (layout, sets)
+    }
+
+    pub(super) fn pipeline(&mut self, key: &PipelineKey, vs: &[u32], fs: Option<&[u32]>) -> Result<vk::Pipeline, String> {
+        let (vset, fset, _) = self.layouts.get(&key.layout).cloned().ok_or("pipeline layout not from the library path")?;
+        let pre = self.shared.pre(key.vertex, vs, &vset, key.depth_clamp, true).map_err(|e| format!("vertex library: {e:?}"))?;
+        let frag = self.shared.frag(key.fragment, fs, &fset, key.alpha_test, true).map_err(|e| format!("fragment library: {e:?}"))?;
+        let vi_key = (key.attributes.clone(), key.bindings.clone(), key.topology);
+        let vi = match self.vertex_inputs.get(&vi_key) {
+            Some(&p) => p,
+            None => {
+                let p = self.shared.vertex_input(key).map_err(|e| format!("vertex input library: {e:?}"))?;
+                *self.vertex_inputs.entry(vi_key).or_insert(p)
+            }
+        };
+        let fo_key = (key.colors.clone(), key.depth, key.blend.clone());
+        let fo = match self.outputs.get(&fo_key) {
+            Some(&p) => p,
+            None => {
+                let p = self.shared.fragment_output(key).map_err(|e| format!("fragment output library: {e:?}"))?;
+                *self.outputs.entry(fo_key).or_insert(p)
+            }
+        };
+        self.links += 1;
+        LINKED.fetch_add(1, Ordering::Relaxed);
+        self.shared.link(&[vi, pre, frag, fo], key.layout).map_err(|e| format!("pipeline link: {e:?}"))
+    }
+
+    /// Translate and compile every program in `file` on spare cores.
+    pub(super) fn start_preload(&mut self, file: &std::path::Path) {
+        let Ok(data) = std::fs::read(file) else { return };
+        let Some(programs) = parse_programs(&data) else {
+            eprintln!("kirikae: {} is not a shader file", file.display());
+            return;
+        };
+        let total = programs.1.len();
+        PRELOAD_TOTAL.store(total, Ordering::Relaxed);
+        PRELOAD_DONE.store(0, Ordering::Relaxed);
+        eprintln!("kirikae: compiling {total} shader programs from {} in the background", file.display());
+        let programs = Arc::new(programs);
+        let next = Arc::new(AtomicUsize::new(0));
+        let failed = Arc::new(AtomicUsize::new(0));
+        let start = std::time::Instant::now();
+        let threads = std::thread::available_parallelism().map_or(2, |n| n.get()).saturating_sub(2).clamp(1, 32);
+        for i in 0..threads {
+            let (programs, next, failed, stop, shared) = (programs.clone(), next.clone(), failed.clone(), self.stop.clone(), self.shared.clone());
+            let w = std::thread::Builder::new().name(format!("kirikae-shaders-{i}")).stack_size(64 << 20).spawn(move || {
+                while !stop.load(Ordering::Relaxed) {
+                    let k = next.fetch_add(1, Ordering::Relaxed);
+                    let Some(&(start_at, len)) = programs.1.get(k) else { return };
+                    let code = &programs.0[start_at..start_at + len];
+                    if compile_program(&shared, code).is_err() {
+                        failed.fetch_add(1, Ordering::Relaxed);
+                    }
+                    let done = PRELOAD_DONE.fetch_add(1, Ordering::Relaxed) + 1;
+                    if done == programs.1.len() {
+                        eprintln!(
+                            "kirikae: compiled {done} shader programs in {:.1} s ({} unique parts, {} not compiled), process memory {} MB",
+                            start.elapsed().as_secs_f64(),
+                            shared.preloaded.load(Ordering::Relaxed),
+                            failed.load(Ordering::Relaxed),
+                            process_memory_mb()
+                        );
+                    }
+                }
+            });
+            if let Ok(w) = w {
+                self.workers.push(w);
+            }
+        }
+    }
+
+    pub(super) fn stop(&mut self) {
+        self.stop.store(true, Ordering::Relaxed);
+        for w in self.workers.drain(..) {
+            let _ = w.join();
+        }
+    }
+
+    pub(super) unsafe fn destroy(&mut self, device: &ash::Device) {
+        self.stop();
+        unsafe {
+            for p in self.vertex_inputs.drain().map(|(_, p)| p).chain(self.outputs.drain().map(|(_, p)| p)) {
+                device.destroy_pipeline(p, None);
+            }
+            self.shared.destroy();
+        }
+    }
+}
+
+/// Memory the process uses, in MB (working set on Windows, resident set elsewhere).
+pub fn process_memory_mb() -> u64 {
+    #[cfg(windows)]
+    {
+        #[repr(C)]
+        #[derive(Default)]
+        struct Counters {
+            cb: u32,
+            page_faults: u32,
+            peak_working_set: usize,
+            working_set: usize,
+            quota_peak_paged: usize,
+            quota_paged: usize,
+            quota_peak_nonpaged: usize,
+            quota_nonpaged: usize,
+            pagefile: usize,
+            peak_pagefile: usize,
+        }
+        unsafe extern "system" {
+            fn GetCurrentProcess() -> isize;
+            fn K32GetProcessMemoryInfo(process: isize, counters: *mut Counters, size: u32) -> i32;
+        }
+        let mut c = Counters { cb: std::mem::size_of::<Counters>() as u32, ..Default::default() };
+        // SAFETY: c is a PROCESS_MEMORY_COUNTERS of the size passed.
+        if unsafe { K32GetProcessMemoryInfo(GetCurrentProcess(), &mut c, c.cb) } != 0 {
+            return c.working_set as u64 >> 20;
+        }
+        0
+    }
+    #[cfg(not(windows))]
+    {
+        std::fs::read_to_string("/proc/self/status").ok().and_then(|s| s.lines().find(|l| l.starts_with("VmRSS")).and_then(|l| l.split_whitespace().nth(1)?.parse::<u64>().ok())).unwrap_or(0) / 1024
+    }
+}
+
+/// `b"KSH1"`, u32 count, then u32 length + bytes per program.
+fn parse_programs(data: &[u8]) -> Option<(Vec<u8>, Vec<(usize, usize)>)> {
+    if data.get(..4)? != b"KSH1" {
+        return None;
+    }
+    let n = u32::from_le_bytes(data.get(4..8)?.try_into().ok()?) as usize;
+    let mut p = 8;
+    let mut out = Vec::with_capacity(n);
+    for _ in 0..n {
+        let len = u32::from_le_bytes(data.get(p..p + 4)?.try_into().ok()?) as usize;
+        p += 4;
+        data.get(p..p + len)?;
+        out.push((p, len));
+        p += len;
+    }
+    Some((data.to_vec(), out))
+}
+
+fn compile_program(shared: &Shared, code: &[u8]) -> Result<(), ()> {
+    let header = kirikae_maxwell::sph::Header::parse(code).ok_or(())?;
+    let stage = match header.shader_type() {
+        1 => Stage::Vertex,
+        5 => Stage::Fragment,
+        _ => return Err(()),
+    };
+    let shader = std::panic::catch_unwind(|| kirikae_maxwell::translate(code, &options(stage), &NoEnv)).map_err(|_| ())?.map_err(|_| ())?;
+    if !shader.unsupported.is_empty() {
+        return Err(());
+    }
+    let id = shared.id(&shader.spirv);
+    let base = if stage == Stage::Fragment { FRAGMENT_BASE } else { VERTEX_BASE };
+    let set = set_key(bindings_of(&shader, base), stage);
+    match stage {
+        Stage::Vertex => {
+            shared.pre(id, &shader.spirv, &set, false, false).map_err(|_| ())?;
+            if !shared.clamp_dynamic {
+                shared.pre(id, &shader.spirv, &set, true, false).map_err(|_| ())?;
+            }
+        }
+        _ => {
+            shared.frag(id, Some(&shader.spirv), &set, [7, 0], false).map_err(|_| ())?;
+        }
+    }
+    Ok(())
+}
