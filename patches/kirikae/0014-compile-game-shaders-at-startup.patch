+impl Renderer {
+    pub(super) fn shaders_file() -> Option<std::path::PathBuf> {
+        if let Some(p) = crate::env_var!("KIRIKAE_SHADERS") {
+            return Some(p.into());
+        }
+        let exe = std::env::current_exe().ok()?;
+        let stem = exe.file_stem()?.to_string_lossy().into_owned();
+        Some(exe.with_file_name(format!("{stem}.shaders")))
+    }
+}
