+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Compiles programs from KIRIKAE_GPL_TEST_FILE (first KIRIKAE_GPL_TEST_LIMIT, default 400) as
+    /// libraries and links every vertex part with a few fragment parts. Run with
+    /// KIRIKAE_VK_VALIDATION=1 to have the validation layer check it all.
+    #[test]
+    #[ignore]
+    fn compile_and_link_game_shaders() {
+        let Ok(path) = std::env::var("KIRIKAE_GPL_TEST_FILE") else { return };
+        let limit: usize = std::env::var("KIRIKAE_GPL_TEST_LIMIT").ok().and_then(|v| v.parse().ok()).unwrap_or(400);
+        let Ok(r) = Renderer::new() else { return };
+        let Some(g) = &r.gpl else {
+            eprintln!("no pipeline library support on this device");
+            return;
+        };
+        let data = std::fs::read(path).unwrap();
+        let (bytes, progs) = parse_programs(&data).unwrap();
+        let start = std::time::Instant::now();
+        let mut fails = 0;
+        let mut vs = Vec::new();
+        let mut fs = Vec::new();
+        for &(at, len) in progs.iter().take(limit) {
+            let code = &bytes[at..at + len];
+            if compile_program(&g.shared, code).is_err() {
+                fails += 1;
+            }
+            let h = kirikae_maxwell::sph::Header::parse(code).unwrap();
+            let stage = if h.shader_type() == 1 { Stage::Vertex } else { Stage::Fragment };
+            if let Ok(s) = kirikae_maxwell::translate(code, &options(stage), &NoEnv) {
+                let base = if stage == Stage::Fragment { FRAGMENT_BASE } else { VERTEX_BASE };
+                let m = g.shared.id(&s.spirv);
+                let entry = (m, set_key(bindings_of(&s, base), stage), s.inputs, s.spirv.clone());
+                if stage == Stage::Vertex { vs.push(entry) } else { fs.push(entry) }
+            }
+        }
+        eprintln!("{} programs compiled in {:.1} s, {fails} failed; {} vertex, {} fragment", limit.min(progs.len()), start.elapsed().as_secs_f64(), vs.len(), fs.len());
+        let mut g = r.gpl.as_ref().map(|g| Gpl {
+            shared: g.shared.clone(),
+            eds3: None,
+            vertex_inputs: HashMap::new(),
+            outputs: HashMap::new(),
+            layouts: HashMap::new(),
+            links: 0,
+            stop: Arc::new(AtomicBool::new(false)),
+            workers: Vec::new(),
+        }).unwrap();
+        let start = std::time::Instant::now();
+        let mut linked = 0;
+        let depth_only = (vk::ShaderModule::null(), set_key(vec![], Stage::Fragment), 0, Vec::new());
+        for (vm, vset, inputs, vcode) in vs.iter() {
+            for (fm, fset, _, fcode) in fs.iter().take(3).chain(std::iter::once(&depth_only)) {
+                let (layout, _) = g.link_layout(vset.clone(), fset.clone());
+                let attributes: Vec<(u32, u32, vk::Format, u32)> = (0..32).filter(|i| inputs >> i & 1 == 1).map(|i| (i, 0, vk::Format::R32G32B32A32_SFLOAT, 0)).collect();
+                let key = PipelineKey {
+                    vertex: *vm,
+                    fragment: *fm,
+                    layout,
+                    topology: vk::PrimitiveTopology::TRIANGLE_LIST,
+                    bindings: if attributes.is_empty() { vec![] } else { vec![(0, 16)] },
+                    attributes,
+                    colors: vec![vk::Format::R8G8B8A8_UNORM],
+                    depth: vk::Format::D24_UNORM_S8_UINT,
+                    blend: vec![[1, 1, 6, 7, 1, 2, 7, 0x1111]],
+                    depth_clamp: false,
+                    alpha_test: [7, 0],
+                };
+                match g.pipeline(&key, vcode, (!fcode.is_empty()).then_some(fcode.as_slice())) {
+                    Ok(p) => {
+                        linked += 1;
+                        unsafe { r.device.destroy_pipeline(p, None) };
+                    }
+                    Err(e) => panic!("link failed: {e}"),
+                }
+            }
+        }
+        eprintln!("{linked} pipelines linked in {:.2} s ({:.2} ms each)", start.elapsed().as_secs_f64(), start.elapsed().as_secs_f64() * 1e3 / linked.max(1) as f64);
+        unsafe {
+            for p in g.vertex_inputs.drain().map(|(_, p)| p).chain(g.outputs.drain().map(|(_, p)| p)) {
+                r.device.destroy_pipeline(p, None);
+            }
+        }
+        assert!(fails * 1000 <= limit.min(progs.len()), "{fails} programs did not compile");
+    }
+}
