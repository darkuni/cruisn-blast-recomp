+#[cfg(test)]
+mod startup_tests {
+    use super::*;
+
+    fn rss_mb() -> u64 {
+        std::fs::read_to_string("/proc/self/status").ok().and_then(|s| s.lines().find(|l| l.starts_with("VmRSS")).and_then(|l| l.split_whitespace().nth(1)?.parse::<u64>().ok())).unwrap_or(0) / 1024
+    }
+
+    /// The real startup path: Renderer::new starts compiling KIRIKAE_SHADERS; wait for it and
+    /// report time and memory.
+    #[test]
+    #[ignore]
+    fn startup_preload() {
+        if std::env::var("KIRIKAE_SHADERS").is_err() {
+            return;
+        }
+        let before = rss_mb();
+        let start = std::time::Instant::now();
+        let Ok(r) = Renderer::new() else { return };
+        let mut last = 0;
+        loop {
+            let (done, total) = (PRELOAD_DONE.load(Ordering::Relaxed), PRELOAD_TOTAL.load(Ordering::Relaxed));
+            if done >= total || r.gpl.is_none() {
+                break;
+            }
+            if done / 2000 != last / 2000 {
+                eprintln!("{done}/{total} after {:.0} s, {} MB", start.elapsed().as_secs_f64(), rss_mb());
+            }
+            last = done;
+            std::thread::sleep(std::time::Duration::from_millis(200));
+        }
+        let s = &r.gpl.as_ref().unwrap().shared;
+        eprintln!(
+            "preload: {:.1} s, {} parts, memory {} MB -> {} MB",
+            start.elapsed().as_secs_f64(),
+            s.preloaded.load(Ordering::Relaxed),
+            before,
+            rss_mb()
+        );
+    }
+}
