diff --git a/crates/maxwell/tests/game_shaders.rs b/crates/maxwell/tests/game_shaders.rs
new file mode 100644
index 0000000..0cdc81f
--- /dev/null
+++ b/crates/maxwell/tests/game_shaders.rs
@@ -0,0 +1,88 @@
+//! Translates every program in a `.shaders` file (tools/extract_shaders.py) with default draw
+//! state and validates the SPIR-V. Run with:
+//!   KIRIKAE_SHADERS=path/to/game.shaders cargo test --release -p kirikae-maxwell --test game_shaders -- --ignored --nocapture
+
+use std::collections::BTreeMap;
+use std::sync::Mutex;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+use kirikae_maxwell::{NoEnv, Options, Stage, sph, translate};
+
+fn programs(file: &[u8]) -> Vec<&[u8]> {
+    assert_eq!(&file[..4], b"KSH1");
+    let n = u32::from_le_bytes(file[4..8].try_into().unwrap()) as usize;
+    let mut p = 8;
+    (0..n)
+        .map(|_| {
+            let len = u32::from_le_bytes(file[p..p + 4].try_into().unwrap()) as usize;
+            p += 4;
+            let code = &file[p..p + len];
+            p += len;
+            code
+        })
+        .collect()
+}
+
+#[test]
+#[ignore]
+fn translate_all_game_shaders() {
+    let Ok(path) = std::env::var("KIRIKAE_SHADERS") else { return };
+    let file = std::fs::read(path).unwrap();
+    let progs = programs(&file);
+    let next = AtomicUsize::new(0);
+    let results: Mutex<BTreeMap<String, (usize, usize)>> = Mutex::new(BTreeMap::new());
+    let unsupported: Mutex<BTreeMap<&'static str, usize>> = Mutex::new(BTreeMap::new());
+    let start = std::time::Instant::now();
+    let threads = std::thread::available_parallelism().map_or(4, |n| n.get());
+    std::thread::scope(|s| {
+        for _ in 0..threads {
+            s.spawn(|| {
+                loop {
+                    let i = next.fetch_add(1, Ordering::Relaxed);
+                    let Some(code) = progs.get(i) else { return };
+                    let Some(h) = sph::Header::parse(code) else {
+                        results.lock().unwrap().entry("no header".into()).or_default().0 += 1;
+                        continue;
+                    };
+                    let stage = match h.shader_type() {
+                        1 => Stage::Vertex,
+                        5 => Stage::Fragment,
+                        t => {
+                            results.lock().unwrap().entry(format!("shader type {t}")).or_default().0 += 1;
+                            continue;
+                        }
+                    };
+                    let base = if stage == Stage::Fragment { 0x80 } else { 0 };
+                    let opts = Options::new(stage, base);
+                    let r = std::panic::catch_unwind(|| translate(code, &opts, &NoEnv));
+                    let outcome = match r {
+                        Err(_) => "panic".to_string(),
+                        Ok(Err(e)) => format!("error {e:?}").chars().take(60).collect(),
+                        Ok(Ok(shader)) => {
+                            for u in &shader.unsupported {
+                                *unsupported.lock().unwrap().entry(u).or_default() += 1;
+                            }
+                            let bytes: Vec<u8> = shader.spirv.iter().flat_map(|w| w.to_le_bytes()).collect();
+                            match naga::front::spv::parse_u8_slice(&bytes, &naga::front::spv::Options::default()) {
+                                Err(naga::front::spv::Error::UnsupportedCapability(_) | naga::front::spv::Error::UnsupportedInstruction(..)) => "ok (naga cannot parse, not checked)".into(),
+                                Err(e) => format!("naga parse {e:?}").chars().take(60).collect(),
+                                Ok(m) => match naga::valid::Validator::new(naga::valid::ValidationFlags::all(), naga::valid::Capabilities::all()).validate(&m) {
+                                    Ok(_) => "ok".into(),
+                                    Err(e) => format!("invalid {:?}", e.as_inner()).chars().take(60).collect(),
+                                },
+                            }
+                        }
+                    };
+                    let mut r = results.lock().unwrap();
+                    let e = r.entry(format!("{stage:?}: {outcome}")).or_default();
+                    e.0 += 1;
+                }
+            });
+        }
+    });
+    eprintln!("{} programs in {:.1} s on {threads} threads", progs.len(), start.elapsed().as_secs_f64());
+    for (k, (n, _)) in results.lock().unwrap().iter() {
+        eprintln!("{n:7}  {k}");
+    }
+    eprintln!("unsupported instructions: {:?}", unsupported.lock().unwrap());
+}
