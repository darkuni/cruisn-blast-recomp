+
+/// Renderer time counters at the last present, to explain slow frames.
+#[derive(Clone, Copy, Default)]
+pub(super) struct FrameMark {
+    at: Option<std::time::Instant>,
+    draw: std::time::Duration,
+    flush: std::time::Duration,
+    readback: std::time::Duration,
+    shader: std::time::Duration,
+    link: std::time::Duration,
+    compile: std::time::Duration,
+    upload: std::time::Duration,
+    image: std::time::Duration,
+    cache_save: std::time::Duration,
+    pipelines: u64,
+    draws: u64,
+    bytes: u64,
+    logged: u32,
+}
+
+impl Renderer {
+    /// With KIRIKAE_STATS set, explain every frame that took over 50 ms.
+    pub(super) fn mark_frame(&mut self) {
+        let now = std::time::Instant::now();
+        let s = &self.stats;
+        let m = self.frame_mark;
+        if let Some(at) = m.at
+            && now - at > std::time::Duration::from_millis(50)
+            && m.logged < 400
+            && crate::env_var!("KIRIKAE_STATS").is_some()
+        {
+            let ms = |a: std::time::Duration, b: std::time::Duration| (a.saturating_sub(b)).as_secs_f64() * 1e3;
+            eprintln!(
+                "kirikae: slow frame {:.0} ms at frame {}: drawing {:.0} ms ({} draws), GPU wait {:.0}, readback {:.0}, shader translation {:.0}, pipeline links {:.0} ({} new), shader compiles {:.0}, texture uploads {:.0}, new images {:.0}, cache save {:.0}, {} MiB streamed; rest is the game itself",
+                (now - at).as_secs_f64() * 1e3,
+                crate::display::FRAMES.load(std::sync::atomic::Ordering::Relaxed),
+                ms(s.draw_time, m.draw),
+                s.draws - m.draws,
+                ms(s.flush_time, m.flush),
+                ms(s.readback_time, m.readback),
+                ms(s.shader_time, m.shader),
+                ms(s.link_time, m.link),
+                s.pipelines - m.pipelines,
+                ms(s.compile_time, m.compile),
+                ms(s.upload_time, m.upload),
+                ms(s.image_time, m.image),
+                ms(s.cache_save_time, m.cache_save),
+                (s.ring_bytes - m.bytes) >> 20,
+            );
+            self.frame_mark.logged += 1;
+        }
+        let logged = self.frame_mark.logged;
+        self.frame_mark = FrameMark {
+            at: Some(now),
+            draw: s.draw_time,
+            flush: s.flush_time,
+            readback: s.readback_time,
+            shader: s.shader_time,
+            link: s.link_time,
+            compile: s.compile_time,
+            upload: s.upload_time,
+            image: s.image_time,
+            cache_save: s.cache_save_time,
+            pipelines: s.pipelines,
+            draws: s.draws,
+            bytes: s.ring_bytes,
+            logged,
+        };
+    }
 }
 
