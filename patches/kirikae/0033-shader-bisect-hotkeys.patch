+                title += &format!(" - {b}");
+            }
             window.set_title(&title);
             self.shown = 0;
             self.since = Instant::now();
diff --git a/crates/rt/src/gpu/vulkan/bisect.rs b/crates/rt/src/gpu/vulkan/bisect.rs
new file mode 100644
index 0000000..d2262f1
--- /dev/null
+++ b/crates/rt/src/gpu/vulkan/bisect.rs
@@ -0,0 +1,51 @@
+//! Shader bisect hotkeys, for finding which shader draws something wrong while looking at it.
+//!
+//! Every fragment shader used by a quad-sized draw (6 vertices or fewer: full-screen effects
+//! such as bloom, colour grading and tonemapping, and on-screen banners) is listed in the order it
+//! was first seen. F6 / F7 skip the next / previous one in that list, F8 stops skipping. The
+//! window title and the log show which shader is being skipped, so the one that makes the
+//! problem disappear can be reported by its address. The keys only work with KIRIKAE_GPU_DIAG.
+
+use std::sync::Mutex;
+
+struct State {
+    seen: Vec<u64>,
+    /// Index into `seen` of the shader being skipped.
+    skipping: Option<usize>,
+}
+
+static STATE: Mutex<State> = Mutex::new(State { seen: Vec::new(), skipping: None });
+
+/// Called for each draw: records quad-sized draws' fragment shaders and says whether to skip it.
+pub fn skip(fragment: u64, vertices: u32) -> bool {
+    let mut s = STATE.lock().unwrap();
+    if vertices <= 6 && !s.seen.contains(&fragment) {
+        s.seen.push(fragment);
+    }
+    s.skipping.is_some_and(|i| s.seen.get(i) == Some(&fragment))
+}
+
+/// F6 (+1), F7 (-1), F8 (0 = stop). Only with KIRIKAE_GPU_DIAG (cruisn-blast-gpu-diagnostics.bat),
+/// so a stray key press in normal play changes nothing.
+pub fn step(dir: i32) {
+    if !super::diag::wanted_checkpoints() {
+        return;
+    }
+    let mut s = STATE.lock().unwrap();
+    let n = s.seen.len();
+    s.skipping = match (dir, s.skipping) {
+        _ if n == 0 || dir == 0 => None,
+        (d, None) => Some(if d > 0 { 0 } else { n - 1 }),
+        (d, Some(i)) => Some((i as i64 + d as i64).rem_euclid(n as i64) as usize),
+    };
+    match s.skipping {
+        Some(i) => eprintln!("kirikae: bisect: skipping fragment shader {:#x} ({}/{n})", s.seen[i], i + 1),
+        None => eprintln!("kirikae: bisect: not skipping"),
+    }
+}
+
+/// For the window title.
+pub fn status() -> Option<String> {
+    let s = STATE.lock().unwrap();
+    s.skipping.map(|i| format!("skipping {:#x} ({}/{})", s.seen[i], i + 1, s.seen.len()))
+}
