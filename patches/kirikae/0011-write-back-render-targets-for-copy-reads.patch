+    /// The newest GPU-written single-level color image starting at `cpu`, read back from
+    /// the GPU as raw texels: (bytes, width, height, bytes per texel). Used to give the copy
+    /// engine a render target's real contents when it reads that memory (ReadPixels).
+    pub fn target_bytes(&mut self, cpu: u64) -> Option<(Vec<u8>, u32, u32, u32)> {
+        let key = self
+            .at(cpu)
+            .iter()
+            .copied()
+            .filter(|k| k.cpu & DERIVED == 0 && aspect_of(k.format) == vk::ImageAspectFlags::COLOR)
+            .filter(|k| self.images.get(k).is_some_and(|i| i.gpu_dirty && i.levels == 1 && i.layers == 1))
+            .max_by_key(|k| self.images[k].stamp)?;
+        let bpp = bytes_per_pixel(key.format)?;
+        let raw = self.read_raw(key, 1)?;
+        Some((raw, key.width, key.height, bpp))
+    }
