@@ -9,7 +9,34 @@
 //! work with KIRIKAE_GPU_DIAG.
 
 use std::sync::Mutex;
-use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::atomic::{AtomicBool, AtomicU8, Ordering};
+
+/// F10: replace a class of textures with black, to see whether the glow comes from them.
+/// 0 off, 1 BC6H cube maps (reflection probes), 2 every cube map, 3 every BC6H texture
+/// (probes and HDR lightmaps).
+static TEXTURE_TEST: AtomicU8 = AtomicU8::new(0);
+const TEXTURE_TESTS: [&str; 4] = ["", "BC6H cube maps black", "all cube maps black", "all BC6H textures black"];
+
+pub fn next_texture_test() {
+    if !super::diag::wanted_checkpoints() {
+        return;
+    }
+    let n = (TEXTURE_TEST.load(Ordering::Relaxed) + 1) % TEXTURE_TESTS.len() as u8;
+    TEXTURE_TEST.store(n, Ordering::Relaxed);
+    eprintln!("kirikae: bisect: texture test {n}: {}", if n == 0 { "off" } else { TEXTURE_TESTS[n as usize] });
+}
+
+/// The texture (TIC components and texture type) is blacked out by the F10 test.
+pub fn black_texture(components: u32, texture_type: u32) -> bool {
+    let bc6h = matches!(components, 0x10 | 0x11);
+    let cube = matches!(texture_type, 3 | 8);
+    match TEXTURE_TEST.load(Ordering::Relaxed) {
+        1 => bc6h && cube,
+        2 => cube,
+        3 => bc6h,
+        _ => false,
+    }
+}
 
 /// F9: save every image the GPU has drawn into at the next whole frame (target-dump/ next to the
 /// game), and log every command of that frame (the GPU trace: each draw's shaders, targets and the
@@ -82,5 +109,11 @@ pub fn step(dir: i32) {
 /// For the window title.
 pub fn status() -> Option<String> {
     let s = STATE.lock().unwrap();
-    s.skipping.map(|i| format!("skipping {:#x} ({}/{})", s.seen[i], i + 1, s.seen.len()))
+    let skip = s.skipping.map(|i| format!("skipping {:#x} ({}/{})", s.seen[i], i + 1, s.seen.len()));
+    let t = TEXTURE_TEST.load(Ordering::Relaxed);
+    let tex = (t != 0).then(|| format!("F10 test {t}: {}", TEXTURE_TESTS[t as usize]));
+    match (skip, tex) {
+        (Some(a), Some(b)) => Some(format!("{a} - {b}")),
+        (a, b) => a.or(b),
+    }
 }
