+    /// Where a register's value was loaded from a constant buffer: `MOV Rd, c[s][o]`,
+    /// `LDC Rd, c[s][imm]` with no index register (also the later words of a 64/128-bit
+    /// LDC), or a register copy of either. Bindless texture handles reach TEX.B this way.
+    fn cbuf_source_depth(&self, pc: u32, reg: u8, depth: u32) -> Option<(u32, u32)> {
         const NO_RD: &[&str] = &["st", "stg", "sts", "stl", "sust", "red", "exit", "bra", "brx", "sync", "ssy", "pbk", "brk", "kil", "depbar", "bar", "membar", "nop", "isetp", "fsetp", "psetp", "hsetp2", "csetp", "dsetp"];
