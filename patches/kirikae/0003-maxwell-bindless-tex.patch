-        (def.name() == "mov" && def.form() == Form::Cbuf).then(|| def.cbuf())
+        const LDC: u64 = 0xef90000000000000;
+        if reg == RZ {
+            return None;
+        }
+        let words = |i: &Insn| -> u8 {
+            if i.op.value == LDC {
+                match i.bits(48, 3) {
+                    5 => 2,
+                    6 => 4,
+                    _ => 1,
+                }
+            } else {
+                1
+            }
+        };
+        let (&def_pc, def) = self.insns.range(..pc).rev().take(512).find(|(_, i)| {
+            !NO_RD.contains(&i.name()) && i.rd() != RZ && reg >= i.rd() && (reg - i.rd()) < words(i)
+        })?;
+        if def.op.value == LDC {
+            if def.ra() != RZ || def.bits(44, 2) != 0 {
+                return None;
+            }
+            let slot = def.bits(36, 5) as u32;
+            let imm = ((def.bits(20, 16) as u32) << 16) as i32 >> 16;
+            let off = imm + 4 * (reg - def.rd()) as i32;
+            return (off >= 0 && off % 4 == 0).then_some((slot, off as u32));
+        }
+        if def.name() == "mov" && reg == def.rd() {
+            match def.form() {
+                Form::Cbuf => return Some(def.cbuf()),
+                Form::Reg if depth > 0 => return self.cbuf_source_depth(def_pc, def.rb(), depth - 1),
+                _ => {}
+            }
+        }
