diff --git a/crates/maxwell/tests/translate.rs b/crates/maxwell/tests/translate.rs
index 660be31..eaf407f 100644
--- a/crates/maxwell/tests/translate.rs
+++ b/crates/maxwell/tests/translate.rs
@@ -322,3 +322,53 @@ fn half_pair_operands() {
     assert!(shader.unsupported.is_empty(), "{:?}", shader.unsupported);
     validate(&shader.spirv);
 }
+
+fn tex_b_2d(rd: u64, ra: u64, rb: u64, lod: u64) -> u64 {
+    0xdeb8_0000_0000_0000 | lod << 37 | 0xf << 31 | 1 << 29 | rb << 20 | PT | ra << 8 | rd
+}
+fn ldc64(rd: u64, slot: u64, offset: u64) -> u64 {
+    0xef90_0000_0000_0000 | 5 << 48 | slot << 36 | offset << 20 | PT | 0xff << 8 | rd
+}
+fn mov_reg(rd: u64, rb: u64) -> u64 {
+    0x5c98_0000_0000_0000 | 0xf << 39 | rb << 20 | PT | rd
+}
+
+#[test]
+fn bindless_tex_from_ldc() {
+    let code = program(fragment_header(1), &[ldc(6, 3, 0x18), ipa(0, 0x80, 0xff), ipa(1, 0x84, 0xff), tex_b_2d(8, 0, 6, 0), EXIT]);
+    let shader = translate(&code, &options(Stage::Fragment), &kirikae_maxwell::NoEnv).unwrap();
+    assert!(shader.unsupported.is_empty(), "{:?}", shader.unsupported);
+    assert_eq!(shader.textures.len(), 1);
+    assert_eq!((shader.textures[0].slot, shader.textures[0].handle), (Some(3), 6));
+    validate(&shader.spirv);
+}
+
+#[test]
+fn bindless_tex_from_the_high_word_of_a_64_bit_ldc_with_explicit_lod() {
+    // R6:R7 = c[2][0x20..0x28]; the handle is R7, so c[2][0x24], word 9. LOD "ll" reads R8.
+    let code = program(
+        fragment_header(1),
+        &[ldc64(6, 2, 0x20), mov32i(8, 0), ipa(0, 0x80, 0xff), ipa(1, 0x84, 0xff), tex_b_2d(10, 0, 7, 3), EXIT],
+    );
+    let shader = translate(&code, &options(Stage::Fragment), &kirikae_maxwell::NoEnv).unwrap();
+    assert!(shader.unsupported.is_empty(), "{:?}", shader.unsupported);
+    assert_eq!((shader.textures[0].slot, shader.textures[0].handle), (Some(2), 9));
+    validate(&shader.spirv);
+}
+
+#[test]
+fn bindless_tex_through_a_register_copy() {
+    let code = program(fragment_header(1), &[ldc(6, 4, 0x8), mov_reg(5, 6), ipa(0, 0x80, 0xff), ipa(1, 0x84, 0xff), tex_b_2d(8, 0, 5, 0), EXIT]);
+    let shader = translate(&code, &options(Stage::Fragment), &kirikae_maxwell::NoEnv).unwrap();
+    assert!(shader.unsupported.is_empty(), "{:?}", shader.unsupported);
+    assert_eq!((shader.textures[0].slot, shader.textures[0].handle), (Some(4), 2));
+    validate(&shader.spirv);
+}
+
+#[test]
+fn bindless_tex_with_a_computed_handle_stays_unsupported() {
+    let code = program(fragment_header(1), &[ldc(6, 3, 0x18), iadd32i(6, 6, 1), ipa(0, 0x80, 0xff), ipa(1, 0x84, 0xff), tex_b_2d(8, 0, 6, 0), EXIT]);
+    let shader = translate(&code, &options(Stage::Fragment), &kirikae_maxwell::NoEnv).unwrap();
+    assert!(shader.unsupported.contains(&"tex (bindless)"), "{:?}", shader.unsupported);
+    assert!(shader.textures.is_empty());
+}
