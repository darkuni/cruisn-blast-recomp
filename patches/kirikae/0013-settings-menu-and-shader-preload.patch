+//! In-game settings menu, frame-rate counter and shader-preload progress.
+//! Open/close: F1 or Esc on the keyboard, Start+Back together on a controller.
+//! The game is paused while the menu is open.
+//!
+//! Same menu as the other native ports: the layout, colours and font (DejaVu Sans Mono Bold)
+//! match them. UI state changes on the window thread (keyboard) and the input thread
+//! (controller); the vertices are built on the render thread when a frame is presented.
+
+use std::sync::Mutex;
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+
+use crate::bindings::{self, CONTROLS, RawPad, xb};
+use crate::settings::{self, Filter};
+
+pub const FONT_CW: f32 = 14.0;
+pub const FONT_CH: f32 = 28.0;
+pub const FONT_W: u32 = 224;
+pub const FONT_H: u32 = 168;
+
+/// Startup pipeline preload progress (set by the renderer).
+pub static PRELOAD_TOTAL: AtomicUsize = AtomicUsize::new(0);
+pub static PRELOAD_DONE: AtomicUsize = AtomicUsize::new(0);
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Nav {
+    Up,
+    Down,
+    Left,
+    Right,
+    Ok,
+    Back,
+}
+
+#[derive(Default)]
+struct Ui {
+    open: bool,
+    sel: usize,
+    quit_armed: bool,
+    /// 0 main menu, 1 keyboard keys, 2 controller buttons
+    keys_page: u8,
+    key_sel: usize,
+    capturing: Option<usize>,
+    /// The controller input that was just bound must not also act on the menu.
+    skip_pad: bool,
+}
+
+static UI: Mutex<Ui> = Mutex::new(Ui { open: false, sel: 0, quit_armed: false, keys_page: 0, key_sel: 0, capturing: None, skip_pad: false });
+static OPEN: AtomicBool = AtomicBool::new(false);
+
+struct Item {
+    label: &'static str,
+    opts: &'static [&'static str],
+    note: Option<&'static str>,
+}
+
+const RESOLUTIONS: [(u32, u32); 4] = [(1280, 720), (1920, 1080), (2560, 1440), (3840, 2160)];
+const ANISOTROPY: [u32; 5] = [1, 2, 4, 8, 16];
+const FRAME_RATES: [u32; 3] = [60, 120, 144];
+
+static ITEMS: &[Item] = &[
+    Item { label: "Resolution", opts: &["1280x720 (handheld)", "1920x1080 (docked)", "2560x1440", "3840x2160"], note: Some("Applies after a restart. Above 1080p is experimental.") },
+    Item { label: "Aspect ratio", opts: &["16:9 (black bars)", "Stretch"], note: Some("How the picture fits a window that is not 16:9.") },
+    Item { label: "VSync", opts: &["Off", "On"], note: None },
+    Item { label: "Fullscreen", opts: &["Off", "On"], note: Some("Also F11 or Alt+Enter.") },
+    Item { label: "Scaling", opts: &["Sharp", "Smooth"], note: Some("How the picture is scaled to the window.") },
+    Item { label: "Texture filtering", opts: &["Off (original)", "2x anisotropic", "4x anisotropic", "8x anisotropic", "16x anisotropic"], note: Some("Sharper road and ground in the distance. Applies after a restart.") },
+    Item { label: "Frame rate", opts: &["60 (original)", "120", "144"], note: Some("Applies after a restart. Above 60 is experimental.") },
+    Item { label: "Vibration", opts: &["Off", "On"], note: Some("Controller rumble, when the game uses it.") },
+    Item { label: "Vibration strength", opts: &["25%", "50%", "75%", "100%"], note: None },
+    Item { label: "Swap A/B and X/Y", opts: &["Off", "On"], note: Some("Gamepad: use the face buttons by position (Nintendo style).") },
+    Item { label: "Frame rate display", opts: &["Off", "On"], note: None },
+    Item { label: "Keyboard keys", opts: &[], note: Some("Change which key presses each Switch button.") },
+    Item { label: "Controller buttons", opts: &[], note: Some("Change which controller button presses each Switch button.") },
+    Item { label: "Close menu", opts: &[], note: None },
+    Item { label: "Quit game", opts: &[], note: None },
+];
+
+fn get_value(i: usize) -> usize {
+    let s = settings::get();
+    let pos = |v: usize| v;
+    match i {
+        0 => RESOLUTIONS.iter().position(|&r| r == (s.render_width, s.render_height)).unwrap_or(1),
+        1 => pos(!s.keep_aspect as usize),
+        2 => s.vsync as usize,
+        3 => s.fullscreen as usize,
+        4 => (s.scale_filter == Filter::Linear) as usize,
+        5 => ANISOTROPY.iter().position(|&a| a >= s.anisotropy).unwrap_or(4),
+        6 => FRAME_RATES.iter().position(|&f| f == s.frame_rate).unwrap_or(0),
+        7 => s.vibration as usize,
+        8 => ((s.vibration_strength as usize + 12) / 25).clamp(1, 4) - 1,
+        9 => s.swap_ab_xy as usize,
+        10 => s.show_fps as usize,
+        _ => 0,
+    }
+}
+
+fn set_value(i: usize, v: usize) {
+    settings::update(|f| {
+        let s = &mut f.settings;
+        match i {
+            0 => (s.render_width, s.render_height) = RESOLUTIONS[v],
+            1 => s.keep_aspect = v == 0,
+            2 => s.vsync = v == 1,
+            3 => s.fullscreen = v == 1,
+            4 => s.scale_filter = if v == 1 { Filter::Linear } else { Filter::Nearest },
+            5 => s.anisotropy = ANISOTROPY[v],
+            6 => s.frame_rate = FRAME_RATES[v],
+            7 => s.vibration = v == 1,
+            8 => s.vibration_strength = (v as u32 + 1) * 25,
+            9 => s.swap_ab_xy = v == 1,
+            10 => s.show_fps = v == 1,
+            _ => {}
+        }
+    });
+    if i == 3 {
+        crate::display::apply_fullscreen(v == 1);
+    }
+}
+
+pub fn is_open() -> bool {
+    OPEN.load(Ordering::Relaxed)
+}
+
+/// The menu owns the controls while open; the game sees nothing pressed.
+pub fn owns_input() -> bool {
+    is_open()
+}
+
+/// The game is held (its last frame shown again) while the menu is open.
+pub fn pausing() -> bool {
+    is_open()
+}
+
+/// 1 when the keyboard page waits for a key, 2 when the controller page waits for an input.
+pub fn capturing() -> u8 {
+    let ui = UI.lock().unwrap();
+    if ui.open && ui.capturing.is_some() { ui.keys_page } else { 0 }
+}
+
+pub fn toggle() {
+    let mut ui = UI.lock().unwrap();
+    ui.open = !ui.open;
+    ui.quit_armed = false;
+    ui.keys_page = 0;
+    ui.capturing = None;
+    OPEN.store(ui.open, Ordering::Relaxed);
+    drop(ui);
+    crate::input::release_all();
+    crate::input::rumble(0.0, 0.0);
+}
+
+/// A key name for the keyboard page, or None to cancel.
+pub fn key_captured(name: Option<&str>) {
+    let mut ui = UI.lock().unwrap();
+    let Some(i) = ui.capturing.take() else { return };
+    if let Some(n) = name.filter(|n| !n.is_empty()) {
+        if ui.keys_page == 2 {
+            bindings::set_pad(i, n);
+        } else {
+            bindings::set_key(i, n);
+        }
+    }
+}
+
+/// Delete on a binding row clears it (no key / no button).
+pub fn clear_binding() {
+    let ui = UI.lock().unwrap();
+    if !ui.open || ui.keys_page == 0 || ui.capturing.is_some() || ui.key_sel >= CONTROLS.len() {
+        return;
+    }
+    if ui.keys_page == 2 {
+        bindings::set_pad(ui.key_sel, "");
+    } else {
+        bindings::set_key(ui.key_sel, "");
+    }
+}
+
+fn keys_rows() -> usize {
+    CONTROLS.len() + 2
+}
+
+fn keys_input(ui: &mut Ui, nav: Nav) {
+    let n = keys_rows();
+    match nav {
+        Nav::Up => ui.key_sel = (ui.key_sel + n - 1) % n,
+        Nav::Down => ui.key_sel = (ui.key_sel + 1) % n,
+        Nav::Back | Nav::Left => ui.keys_page = 0,
+        Nav::Ok | Nav::Right => {
+            if ui.key_sel < CONTROLS.len() {
+                ui.capturing = Some(ui.key_sel);
+            } else if ui.key_sel == CONTROLS.len() {
+                if ui.keys_page == 2 {
+                    bindings::reset_pad();
+                } else {
+                    bindings::reset_keys();
+                }
+            } else {
+                ui.keys_page = 0;
+            }
+        }
+    }
+}
+
+pub fn input(nav: Nav) {
+    let mut ui = UI.lock().unwrap();
+    if !ui.open {
+        return;
+    }
+    if ui.keys_page != 0 {
+        if ui.capturing.is_none() {
+            keys_input(&mut ui, nav);
+        }
+        return;
+    }
+    let n = ITEMS.len();
+    match nav {
+        Nav::Up => {
+            ui.sel = (ui.sel + n - 1) % n;
+            ui.quit_armed = false;
+        }
+        Nav::Down => {
+            ui.sel = (ui.sel + 1) % n;
+            ui.quit_armed = false;
+        }
+        Nav::Back => {
+            drop(ui);
+            toggle();
+        }
+        Nav::Left | Nav::Right | Nav::Ok => {
+            let sel = ui.sel;
+            let item = &ITEMS[sel];
+            if item.opts.is_empty() {
+                if nav != Nav::Ok {
+                    return;
+                }
+                match sel {
+                    _ if sel == n - 4 => {
+                        ui.keys_page = 1;
+                        ui.key_sel = 0;
+                    }
+                    _ if sel == n - 3 => {
+                        ui.keys_page = 2;
+                        ui.key_sel = 0;
+                    }
+                    _ if sel == n - 2 => {
+                        drop(ui);
+                        toggle();
+                    }
+                    _ => {
+                        if ui.quit_armed {
+                            drop(ui);
+                            crate::display::quit();
+                        } else {
+                            ui.quit_armed = true;
+                        }
+                    }
+                }
+                return;
+            }
+            drop(ui);
+            let cnt = item.opts.len();
+            let v = get_value(sel);
+            let v = if nav == Nav::Left { (v + cnt - 1) % cnt } else { (v + 1) % cnt };
+            set_value(sel, v);
+        }
+    }
+}
+
+/// Controller: Start+Back toggles the menu, the d-pad / left stick and A (bottom) / B (right)
+/// drive it, and the controller page binds the next input pressed.
+pub fn pad_input(raw: &RawPad) {
+    static PREV: Mutex<RawPad> = Mutex::new(RawPad { buttons: 0, lt: 0, rt: 0, lx: 0, ly: 0, rx: 0, ry: 0 });
+    let mut prev = PREV.lock().unwrap();
+    let nav_bits = |r: &RawPad| {
+        let mut b = r.buttons;
+        if r.lx > 16000 {
+            b |= xb::DPRIGHT;
+        }
+        if r.lx < -16000 {
+            b |= xb::DPLEFT;
+        }
+        if r.ly > 16000 {
+            b |= xb::DPUP;
+        }
+        if r.ly < -16000 {
+            b |= xb::DPDOWN;
+        }
+        b
+    };
+    let (now_bits, was_bits) = (nav_bits(raw), nav_bits(&prev));
+    let mut down = now_bits & !was_bits;
+    let captured = if capturing() == 2 { bindings::newly_pressed(&prev, raw) } else { None };
+    *prev = *raw;
+    drop(prev);
+    if let Some(name) = captured {
+        key_captured(Some(name));
+        UI.lock().unwrap().skip_pad = true;
+        return;
+    }
+    {
+        let mut ui = UI.lock().unwrap();
+        if ui.skip_pad {
+            ui.skip_pad = false;
+            down = 0;
+        }
+        if ui.capturing.is_some() {
+            return;
+        }
+    }
+    if down & (xb::START | xb::BACK) != 0 && now_bits & xb::START != 0 && now_bits & xb::BACK != 0 {
+        toggle();
+        return;
+    }
+    if !is_open() {
+        return;
+    }
+    let nav = [(xb::DPUP, Nav::Up), (xb::DPDOWN, Nav::Down), (xb::DPLEFT, Nav::Left), (xb::DPRIGHT, Nav::Right), (xb::A, Nav::Ok), (xb::B, Nav::Back)];
+    if let Some(&(_, n)) = nav.iter().find(|(bit, _)| down & bit != 0) {
+        input(n);
+    }
+}
+
+// ---------------------------------------------------------------- drawing
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct Vertex {
+    pub x: f32,
+    pub y: f32,
+    pub u: f32,
+    pub v: f32,
+    pub color: [f32; 4],
+}
+
+struct Builder {
+    verts: Vec<Vertex>,
+}
+
+impl Builder {
+    fn quad(&mut self, x: f32, y: f32, w: f32, h: f32, uv: [f32; 4], c: [f32; 4]) {
+        let [u0, v0, u1, v1] = uv;
+        let v = |x, y, u, v| Vertex { x, y, u, v, color: c };
+        let (a, b, d, e) = (v(x, y, u0, v0), v(x + w, y, u1, v0), v(x, y + h, u0, v1), v(x + w, y + h, u1, v1));
+        self.verts.extend_from_slice(&[a, b, d, b, e, d]);
+    }
+
+    fn rect(&mut self, x: f32, y: f32, w: f32, h: f32, c: [f32; 4]) {
+        self.quad(x, y, w, h, [-1.0, 0.0, -1.0, 0.0], c);
+    }
+
+    fn text(&mut self, mut x: f32, y: f32, s: f32, text: &str, c: [f32; 4]) -> f32 {
+        for ch in text.chars() {
+            let ch = if (' '..='\u{7f}').contains(&ch) { ch as u32 } else { '?' as u32 };
+            let i = ch - 32;
+            let u0 = (i % 16) as f32 * FONT_CW / FONT_W as f32;
+            let v0 = (i / 16) as f32 * FONT_CH / FONT_H as f32;
+            self.quad(x, y, FONT_CW * s, FONT_CH * s, [u0, v0, u0 + FONT_CW / FONT_W as f32, v0 + FONT_CH / FONT_H as f32], c);
+            x += FONT_CW * s;
+        }
+        x
+    }
+}
+
+const WHITE: [f32; 4] = [1.0, 1.0, 1.0, 1.0];
+const GREY: [f32; 4] = [0.7, 0.7, 0.75, 1.0];
+const GOLD: [f32; 4] = [1.0, 0.85, 0.3, 1.0];
+const PANEL: [f32; 4] = [0.05, 0.07, 0.15, 0.88];
+const HIGHLIGHT: [f32; 4] = [0.25, 0.35, 0.7, 0.9];
+const SHADE: [f32; 4] = [0.0, 0.0, 0.0, 0.45];
+
+fn fps_text() -> Option<String> {
+    static LAST: Mutex<Option<(std::time::Instant, u64, String)>> = Mutex::new(None);
+    if !settings::get().show_fps {
+        return None;
+    }
+    let frames = crate::display::FRAMES.load(Ordering::Relaxed);
+    let mut last = LAST.lock().unwrap();
+    let now = std::time::Instant::now();
+    match last.as_mut() {
+        None => *last = Some((now, frames, String::new())),
+        Some((t, f, text)) => {
+            let secs = now.duration_since(*t).as_secs_f64();
+            if secs >= 1.0 {
+                *text = format!("{:.0} FPS", (frames - *f) as f64 / secs);
+                *t = now;
+                *f = frames;
+            }
+        }
+    }
+    last.as_ref().map(|l| l.2.clone()).filter(|t| !t.is_empty())
+}
+
+/// Vertices for this frame in window pixels (top-left origin), or nothing to draw.
+pub fn build(ww: u32, wh: u32) -> Vec<Vertex> {
+    let (open, sel, armed, keys_page, key_sel, capturing) = {
+        let ui = UI.lock().unwrap();
+        (ui.open, ui.sel, ui.quit_armed, ui.keys_page, ui.key_sel, ui.capturing)
+    };
+    let fps = fps_text();
+    let (done, total) = (PRELOAD_DONE.load(Ordering::Relaxed), PRELOAD_TOTAL.load(Ordering::Relaxed));
+    let preloading = total > 0 && done < total;
+    if !open && fps.is_none() && !preloading {
+        return Vec::new();
+    }
+    let (ww, wh) = (ww as f32, wh as f32);
+    let mut b = Builder { verts: Vec::new() };
+    let mut s = (wh / 900.0).max(0.6);
+    if let Some(t) = &fps {
+        let tw = t.len() as f32 * FONT_CW * s * 0.8;
+        b.rect(ww - tw - 16.0 * s, 8.0 * s, tw + 12.0 * s, FONT_CH * s * 0.8 + 6.0 * s, SHADE);
+        b.text(ww - tw - 10.0 * s, 11.0 * s, s * 0.8, t, WHITE);
+    }
+    if preloading {
+        let t = format!("Preloading shaders  {done} / {total}");
+        let tw = t.len() as f32 * FONT_CW * s * 0.8;
+        let y = wh - FONT_CH * s * 0.8 - 14.0 * s;
+        b.rect(8.0 * s, y - 3.0 * s, tw + 12.0 * s, FONT_CH * s * 0.8 + 6.0 * s, SHADE);
+        b.text(14.0 * s, y, s * 0.8, &t, GOLD);
+    }
+    if open && keys_page != 0 {
+        let n = keys_rows();
+        s = s.min(wh * 0.92 / ((n as f32 + 4.5) * FONT_CH * 1.25));
+        let lh = FONT_CH * s * 1.25;
+        let (pw, ph) = (46.0 * FONT_CW * s, (n as f32 + 4.5) * lh);
+        let (px, py) = ((ww - pw) / 2.0, (wh - ph) / 2.0);
+        b.rect(0.0, 0.0, ww, wh, SHADE);
+        b.rect(px, py, pw, ph, PANEL);
+        b.text(px + 20.0 * s, py + 14.0 * s, s, if keys_page == 2 { "CONTROLLER BUTTONS" } else { "KEYBOARD KEYS" }, GOLD);
+        let mut y = py + 14.0 * s + lh * 1.4;
+        for i in 0..n {
+            if i == key_sel {
+                b.rect(px + 8.0 * s, y - 4.0 * s, pw - 16.0 * s, lh, HIGHLIGHT);
+            }
+            let col = if i == key_sel { WHITE } else { GREY };
+            if i < CONTROLS.len() {
+                b.text(px + 20.0 * s, y, s, CONTROLS[i].label, col);
+                let k = if capturing == Some(i) {
+                    (if keys_page == 2 { "press a button..." } else { "press a key..." }).to_string()
+                } else if keys_page == 2 {
+                    bindings::pad_binding(i)
+                } else {
+                    bindings::key_binding(i)
+                };
+                let k = if k.is_empty() { "-".to_string() } else { k };
+                b.text(px + 20.0 * s + 22.0 * FONT_CW * s, y, s, &k, if capturing == Some(i) { GOLD } else { WHITE });
+            } else {
+                b.text(px + 20.0 * s, y, s, if i == CONTROLS.len() { "Reset to defaults" } else { "Back" }, col);
+            }
+            y += lh;
+        }
+        let hint = match (capturing.is_some(), keys_page) {
+            (true, 2) => "Press the controller button, trigger or stick direction. Esc cancels.",
+            (true, _) => "Press the new key. Esc cancels.",
+            _ => "Enter: change   Delete: clear   Left / Backspace: back",
+        };
+        b.text(px + 20.0 * s, y + lh * 0.4, s * 0.75, hint, if capturing.is_some() { GOLD } else { GREY });
+        b.text(px + 20.0 * s, y + lh * 1.3, s * 0.75, "Menu keys (arrows, Enter, Esc, F1) always work in this menu.", GREY);
+    } else if open {
+        let lh = FONT_CH * s * 1.35;
+        let (pw, ph) = (46.0 * FONT_CW * s, (ITEMS.len() as f32 + 4.5) * lh);
+        let (px, py) = ((ww - pw) / 2.0, (wh - ph) / 2.0);
+        b.rect(0.0, 0.0, ww, wh, SHADE);
+        b.rect(px, py, pw, ph, PANEL);
+        b.text(px + 20.0 * s, py + 14.0 * s, s, "SETTINGS", GOLD);
+        let mut y = py + 14.0 * s + lh * 1.4;
+        for (i, item) in ITEMS.iter().enumerate() {
+            if i == sel {
+                b.rect(px + 8.0 * s, y - 4.0 * s, pw - 16.0 * s, lh, HIGHLIGHT);
+            }
+            b.text(px + 20.0 * s, y, s, item.label, if i == sel { WHITE } else { GREY });
+            if !item.opts.is_empty() {
+                b.text(px + 20.0 * s + 20.0 * FONT_CW * s, y, s, &format!("< {} >", item.opts[get_value(i)]), WHITE);
+            } else if i == sel && armed {
+                b.text(px + 20.0 * s + 20.0 * FONT_CW * s, y, s, "press again to quit", GOLD);
+            }
+            y += lh;
+        }
+        let note = ITEMS[sel].note.unwrap_or("Up/Down select, Left/Right change. Saved to the .ini file.");
+        b.text(px + 20.0 * s, y + lh * 0.4, s * 0.75, note, GREY);
+        b.text(px + 20.0 * s, y + lh * 1.3, s * 0.75, "F1 / Esc / Start+Back: close", GREY);
+    }
+    b.verts
+}
+
+#[cfg(test)]
+pub(crate) fn test_open(sel: usize) {
+    let mut ui = UI.lock().unwrap();
+    ui.open = true;
+    ui.sel = sel;
+    OPEN.store(true, Ordering::Relaxed);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn closed_menu_draws_nothing() {
+        if !is_open() && !settings::get().show_fps && PRELOAD_TOTAL.load(Ordering::Relaxed) == 0 {
+            assert!(build(1920, 1080).is_empty());
+        }
+    }
+
+    #[test]
+    fn every_option_value_is_in_range() {
+        for (i, item) in ITEMS.iter().enumerate() {
+            if !item.opts.is_empty() {
+                assert!(get_value(i) < item.opts.len(), "{}", item.label);
+            }
+        }
+    }
+}
