diff --git a/crates/rt/src/gpu/vulkan/preload.rs b/crates/rt/src/gpu/vulkan/preload.rs
new file mode 100644
index 0000000..0c34d6b
--- /dev/null
+++ b/crates/rt/src/gpu/vulkan/preload.rs
@@ -0,0 +1,434 @@
+//! Pipeline preloading.
+//!
+//! Every graphics pipeline the game asks for is recorded (its SPIR-V and fixed-function state)
+//! in `<exe name>.pipelines` next to the executable. On the next start all recorded pipelines
+//! are built on spare cores while the game boots, and translated shaders whose SPIR-V matches a
+//! preloaded module reuse it, so the game's own pipeline lookups hit them directly instead of
+//! compiling (and skipping draws) the first time a track or car appears.
+
+use std::collections::{HashMap, HashSet};
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+use std::sync::{Arc, Mutex};
+
+use ash::vk;
+
+use super::Renderer;
+use super::pipeline::{Built, LayoutKey, PipelineKey, build_pipeline};
+
+const MAGIC: &[u8; 4] = b"KPL1";
+
+#[derive(Clone, PartialEq, Eq, Hash, Debug)]
+pub(super) struct Rec {
+    pub(super) vertex: u64,
+    pub(super) fragment: u64,
+    pub(super) layout: (Vec<(u32, i32)>, u32),
+    pub(super) topology: i32,
+    pub(super) attributes: Vec<(u32, u32, i32, u32)>,
+    pub(super) bindings: Vec<(u32, u32)>,
+    pub(super) colors: Vec<i32>,
+    pub(super) depth: i32,
+    pub(super) blend: Vec<[u32; 8]>,
+    pub(super) depth_clamp: bool,
+    pub(super) alpha_test: [u32; 2],
+}
+
+#[derive(Default)]
+pub(super) struct Manifest {
+    pub(super) spirv: HashMap<u64, Arc<Vec<u32>>>,
+    pub(super) recs: Vec<Rec>,
+}
+
+pub(super) fn spirv_hash(words: &[u32]) -> u64 {
+    let mut h = 0xcbf2_9ce4_8422_2325u64;
+    for w in words {
+        h = (h ^ *w as u64).wrapping_mul(0x0000_0100_0000_01b3);
+    }
+    h ^ (words.len() as u64) << 40
+}
+
+struct Writer(Vec<u8>);
+impl Writer {
+    fn u32(&mut self, v: u32) {
+        self.0.extend_from_slice(&v.to_le_bytes());
+    }
+    fn i32(&mut self, v: i32) {
+        self.u32(v as u32);
+    }
+    fn u64(&mut self, v: u64) {
+        self.0.extend_from_slice(&v.to_le_bytes());
+    }
+}
+
+struct Reader<'a>(&'a [u8]);
+impl Reader<'_> {
+    fn u32(&mut self) -> Option<u32> {
+        let (b, rest) = self.0.split_first_chunk::<4>()?;
+        self.0 = rest;
+        Some(u32::from_le_bytes(*b))
+    }
+    fn i32(&mut self) -> Option<i32> {
+        self.u32().map(|v| v as i32)
+    }
+    fn u64(&mut self) -> Option<u64> {
+        let (b, rest) = self.0.split_first_chunk::<8>()?;
+        self.0 = rest;
+        Some(u64::from_le_bytes(*b))
+    }
+    fn count(&mut self, limit: u32) -> Option<usize> {
+        self.u32().filter(|&n| n <= limit).map(|n| n as usize)
+    }
+}
+
+impl Manifest {
+    pub(super) fn encode(&self) -> Vec<u8> {
+        let mut w = Writer(Vec::new());
+        let mut hashes: Vec<&u64> = self.spirv.keys().collect();
+        hashes.sort();
+        w.u32(hashes.len() as u32);
+        for h in hashes {
+            let words = &self.spirv[h];
+            w.u64(*h);
+            w.u32(words.len() as u32);
+            for x in words.iter() {
+                w.u32(*x);
+            }
+        }
+        w.u32(self.recs.len() as u32);
+        for r in &self.recs {
+            w.u64(r.vertex);
+            w.u64(r.fragment);
+            w.u32(r.layout.0.len() as u32);
+            for &(b, t) in &r.layout.0 {
+                w.u32(b);
+                w.i32(t);
+            }
+            w.u32(r.layout.1);
+            w.i32(r.topology);
+            w.u32(r.attributes.len() as u32);
+            for &(l, b, f, o) in &r.attributes {
+                w.u32(l);
+                w.u32(b);
+                w.i32(f);
+                w.u32(o);
+            }
+            w.u32(r.bindings.len() as u32);
+            for &(b, s) in &r.bindings {
+                w.u32(b);
+                w.u32(s);
+            }
+            w.u32(r.colors.len() as u32);
+            for &c in &r.colors {
+                w.i32(c);
+            }
+            w.i32(r.depth);
+            w.u32(r.blend.len() as u32);
+            for b in &r.blend {
+                for &x in b {
+                    w.u32(x);
+                }
+            }
+            w.u32(r.depth_clamp as u32);
+            w.u32(r.alpha_test[0]);
+            w.u32(r.alpha_test[1]);
+        }
+        let mut out = MAGIC.to_vec();
+        out.extend_from_slice(&(w.0.len() as u32).to_le_bytes());
+        out.extend_from_slice(&miniz_oxide::deflate::compress_to_vec(&w.0, 6));
+        out
+    }
+
+    pub(super) fn decode(file: &[u8]) -> Option<Manifest> {
+        if file.get(..4)? != MAGIC {
+            return None;
+        }
+        let raw = miniz_oxide::inflate::decompress_to_vec_with_limit(file.get(8..)?, 1 << 30).ok()?;
+        let mut r = Reader(&raw);
+        let mut m = Manifest::default();
+        for _ in 0..r.count(1 << 20)? {
+            let h = r.u64()?;
+            let n = r.count(1 << 24)?;
+            let words: Option<Vec<u32>> = (0..n).map(|_| r.u32()).collect();
+            m.spirv.insert(h, Arc::new(words?));
+        }
+        for _ in 0..r.count(1 << 22)? {
+            let vertex = r.u64()?;
+            let fragment = r.u64()?;
+            let layout_bindings: Option<Vec<(u32, i32)>> = (0..r.count(256)?).map(|_| Some((r.u32()?, r.i32()?))).collect();
+            let layout = (layout_bindings?, r.u32()?);
+            let topology = r.i32()?;
+            let attributes: Option<Vec<_>> = (0..r.count(64)?).map(|_| Some((r.u32()?, r.u32()?, r.i32()?, r.u32()?))).collect();
+            let bindings: Option<Vec<_>> = (0..r.count(64)?).map(|_| Some((r.u32()?, r.u32()?))).collect();
+            let colors: Option<Vec<_>> = (0..r.count(16)?).map(|_| r.i32()).collect();
+            let depth = r.i32()?;
+            let blend: Option<Vec<[u32; 8]>> = (0..r.count(16)?)
+                .map(|_| {
+                    let mut b = [0u32; 8];
+                    for x in &mut b {
+                        *x = r.u32()?;
+                    }
+                    Some(b)
+                })
+                .collect();
+            let depth_clamp = r.u32()? != 0;
+            let alpha_test = [r.u32()?, r.u32()?];
+            m.recs.push(Rec {
+                vertex,
+                fragment,
+                layout,
+                topology,
+                attributes: attributes?,
+                bindings: bindings?,
+                colors: colors?,
+                depth,
+                blend: blend?,
+                depth_clamp,
+                alpha_test,
+            });
+        }
+        Some(m)
+    }
+}
+
+pub(super) fn manifest_file() -> Option<std::path::PathBuf> {
+    if crate::env_var!("KIRIKAE_NO_PRELOAD").is_some() {
+        return None;
+    }
+    if let Some(p) = crate::env_var!("KIRIKAE_PRELOAD_FILE") {
+        return Some(p.into());
+    }
+    let exe = std::env::current_exe().ok()?;
+    let stem = exe.file_stem()?.to_string_lossy().into_owned();
+    Some(exe.with_file_name(format!("{stem}.pipelines")))
+}
+
+use crate::overlay::{PRELOAD_DONE, PRELOAD_TOTAL};
+
+pub(super) struct Preloader {
+    results: Arc<Mutex<Vec<Built>>>,
+    stop: Arc<AtomicBool>,
+    workers: Vec<std::thread::JoinHandle<()>>,
+}
+
+/// What the renderer keeps for preloading and recording.
+#[derive(Default)]
+pub(super) struct PreloadState {
+    pub(super) file: Option<std::path::PathBuf>,
+    pub(super) module_by_spirv: HashMap<u64, vk::ShaderModule>,
+    pub(super) spirv_by_module: HashMap<vk::ShaderModule, u64>,
+    pub(super) words: HashMap<u64, Arc<Vec<u32>>>,
+    pub(super) layout_keys: HashMap<vk::PipelineLayout, LayoutKey>,
+    pub(super) recorded: HashSet<Rec>,
+    pub(super) order: Vec<Rec>,
+    pub(super) dirty: bool,
+    pub(super) running: Option<Preloader>,
+}
+
+impl Renderer {
+    /// Load the manifest and start building its pipelines in the background.
+    pub(super) fn start_preload(&mut self) {
+        self.preload.file = manifest_file();
+        let Some(file) = self.preload.file.clone() else { return };
+        let Some(m) = std::fs::read(&file).ok().and_then(|d| Manifest::decode(&d)) else { return };
+        let start = std::time::Instant::now();
+        for (h, words) in &m.spirv {
+            let Ok(module) = (unsafe { self.device.create_shader_module(&vk::ShaderModuleCreateInfo::default().code(words), None) }) else { continue };
+            self.preload.module_by_spirv.insert(*h, module);
+            self.preload.spirv_by_module.insert(module, *h);
+            self.preload.words.insert(*h, words.clone());
+        }
+        let mut keys = Vec::new();
+        for r in m.recs {
+            let module = |h: u64| if h == 0 { Some(vk::ShaderModule::null()) } else { self.preload.module_by_spirv.get(&h).copied() };
+            let (Some(vertex), Some(fragment)) = (module(r.vertex), module(r.fragment)) else { continue };
+            let bindings: Vec<(u32, vk::DescriptorType)> = r.layout.0.iter().map(|&(b, t)| (b, vk::DescriptorType::from_raw(t))).collect();
+            let (_, layout) = self.layout(&bindings, vk::ShaderStageFlags::from_raw(r.layout.1));
+            keys.push(PipelineKey {
+                vertex,
+                fragment,
+                layout,
+                topology: vk::PrimitiveTopology::from_raw(r.topology),
+                attributes: r.attributes.iter().map(|&(l, b, f, o)| (l, b, vk::Format::from_raw(f), o)).collect(),
+                bindings: r.bindings.clone(),
+                colors: r.colors.iter().map(|&c| vk::Format::from_raw(c)).collect(),
+                depth: vk::Format::from_raw(r.depth),
+                blend: r.blend.clone(),
+                depth_clamp: r.depth_clamp,
+                alpha_test: r.alpha_test,
+            });
+            if self.preload.recorded.insert(r.clone()) {
+                self.preload.order.push(r);
+            }
+        }
+        let total = keys.len();
+        PRELOAD_TOTAL.store(total, Ordering::Relaxed);
+        PRELOAD_DONE.store(0, Ordering::Relaxed);
+        eprintln!("kirikae: preloading {total} pipelines from {} ({} shaders, {:.0} ms to load)", file.display(), m.spirv.len(), start.elapsed().as_secs_f64() * 1e3);
+        if total == 0 {
+            return;
+        }
+        let keys = Arc::new(keys);
+        let next = Arc::new(AtomicUsize::new(0));
+        let results = Arc::new(Mutex::new(Vec::new()));
+        let stop = Arc::new(AtomicBool::new(false));
+        let threads = std::thread::available_parallelism().map_or(2, |n| n.get()).saturating_sub(2).clamp(1, 16);
+        let workers = (0..threads)
+            .filter_map(|i| {
+                let (keys, next, results, stop, device, cache) = (keys.clone(), next.clone(), results.clone(), stop.clone(), self.device.clone(), self.pipeline_cache);
+                std::thread::Builder::new()
+                    .name(format!("kirikae-preload-{i}"))
+                    .spawn(move || {
+                        while !stop.load(Ordering::Relaxed) {
+                            let i = next.fetch_add(1, Ordering::Relaxed);
+                            let Some(key) = keys.get(i) else { return };
+                            let r = build_pipeline(&device, cache, key);
+                            results.lock().unwrap().push((key.clone(), r));
+                            let done = PRELOAD_DONE.fetch_add(1, Ordering::Relaxed) + 1;
+                            if done == keys.len() {
+                                eprintln!("kirikae: preloaded {done} pipelines in {:.1} s", start.elapsed().as_secs_f64());
+                            }
+                        }
+                    })
+                    .ok()
+            })
+            .collect();
+        self.preload.running = Some(Preloader { results, stop, workers });
+    }
+
+    /// Move finished preloaded pipelines into the pipeline table.
+    pub(super) fn drain_preload(&mut self) {
+        let Some(p) = &self.preload.running else { return };
+        let built: Vec<Built> = std::mem::take(&mut *p.results.lock().unwrap());
+        let finished = p.workers.iter().all(|w| w.is_finished());
+        for (key, r) in built {
+            match r {
+                Ok(pipe) if self.pipelines.contains_key(&key) => unsafe { self.device.destroy_pipeline(pipe, None) },
+                Ok(pipe) => {
+                    self.pipelines.insert(key, pipe);
+                    self.stats.pipelines += 1;
+                }
+                Err(e) => eprintln!("kirikae: preloaded pipeline failed ({e:?})"),
+            }
+        }
+        if finished && p.results.lock().unwrap().is_empty() {
+            self.preload.running = None;
+        }
+    }
+
+    pub(super) fn stop_preload(&mut self) {
+        if let Some(p) = &mut self.preload.running {
+            p.stop.store(true, Ordering::Relaxed);
+            for w in p.workers.drain(..) {
+                let _ = w.join();
+            }
+        }
+        self.drain_preload();
+        self.preload.running = None;
+    }
+
+    /// The module for this SPIR-V: a preloaded or earlier one with the same code, or a new one.
+    pub(super) fn module_for(&mut self, spirv: &[u32]) -> Result<vk::ShaderModule, vk::Result> {
+        let h = spirv_hash(spirv);
+        if let Some(&m) = self.preload.module_by_spirv.get(&h)
+            && self.preload.words.get(&h).is_some_and(|w| w.as_slice() == spirv)
+        {
+            return Ok(m);
+        }
+        let module = unsafe { self.device.create_shader_module(&vk::ShaderModuleCreateInfo::default().code(spirv), None)? };
+        if self.preload.file.is_none() {
+            return Ok(module);
+        }
+        if !self.preload.module_by_spirv.contains_key(&h) {
+            self.preload.module_by_spirv.insert(h, module);
+            self.preload.words.insert(h, Arc::new(spirv.to_vec()));
+        }
+        // A hash collision with different code is not recorded.
+        if self.preload.words.get(&h).is_some_and(|w| w.as_slice() == spirv) {
+            self.preload.spirv_by_module.insert(module, h);
+        }
+        Ok(module)
+    }
+
+    /// Note a pipeline the game asked for, for the next start's preload.
+    pub(super) fn record_pipeline(&mut self, key: &PipelineKey) {
+        if self.preload.file.is_none() {
+            return;
+        }
+        let hash = |m: vk::ShaderModule| if m == vk::ShaderModule::null() { Some(0) } else { self.preload.spirv_by_module.get(&m).copied() };
+        let (Some(vertex), Some(fragment), Some(layout)) = (hash(key.vertex), hash(key.fragment), self.preload.layout_keys.get(&key.layout)) else { return };
+        if (vertex != 0 && !self.preload.words.contains_key(&vertex)) || (fragment != 0 && !self.preload.words.contains_key(&fragment)) {
+            return;
+        }
+        let rec = Rec {
+            vertex,
+            fragment,
+            layout: (layout.0.iter().map(|&(b, t)| (b, t.as_raw())).collect(), layout.1),
+            topology: key.topology.as_raw(),
+            attributes: key.attributes.iter().map(|&(l, b, f, o)| (l, b, f.as_raw(), o)).collect(),
+            bindings: key.bindings.clone(),
+            colors: key.colors.iter().map(|c| c.as_raw()).collect(),
+            depth: key.depth.as_raw(),
+            blend: key.blend.clone(),
+            depth_clamp: key.depth_clamp,
+            alpha_test: key.alpha_test,
+        };
+        if self.preload.recorded.insert(rec.clone()) {
+            self.preload.order.push(rec);
+            self.preload.dirty = true;
+        }
+    }
+
+    /// Snapshot for writing the manifest off the render thread.
+    pub(super) fn manifest_snapshot(&mut self) -> Option<(std::path::PathBuf, Manifest)> {
+        if !self.preload.dirty {
+            return None;
+        }
+        let file = self.preload.file.clone()?;
+        self.preload.dirty = false;
+        let mut used = HashSet::new();
+        for r in &self.preload.order {
+            used.insert(r.vertex);
+            used.insert(r.fragment);
+        }
+        let spirv = used.iter().filter_map(|h| self.preload.words.get(h).map(|w| (*h, w.clone()))).collect();
+        Some((file, Manifest { spirv, recs: self.preload.order.clone() }))
+    }
+}
+
+pub(super) fn write_manifest(file: &std::path::Path, m: &Manifest) {
+    let tmp = file.with_extension(format!("pipelines.{}.tmp", std::process::id()));
+    if std::fs::write(&tmp, m.encode()).is_err() || std::fs::rename(&tmp, file).is_err() {
+        let _ = std::fs::remove_file(&tmp);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn manifest_round_trip() {
+        let mut m = Manifest::default();
+        m.spirv.insert(5, Arc::new(vec![0x0723_0203, 1, 2, 3]));
+        m.spirv.insert(9, Arc::new(vec![0x0723_0203, 7]));
+        m.recs.push(Rec {
+            vertex: 5,
+            fragment: 9,
+            layout: (vec![(0, 6), (40, 1)], 0x11),
+            topology: 3,
+            attributes: vec![(0, 0, 109, 0), (1, 0, 37, 12)],
+            bindings: vec![(0, 16)],
+            colors: vec![44, 97],
+            depth: 129,
+            blend: vec![[1, 2, 3, 4, 5, 6, 7, 8]],
+            depth_clamp: true,
+            alpha_test: [7, 0x3f00_0000],
+        });
+        m.recs.push(Rec { fragment: 0, colors: vec![], blend: vec![], ..m.recs[0].clone() });
+        let back = Manifest::decode(&m.encode()).unwrap();
+        assert_eq!(back.recs, m.recs);
+        assert_eq!(back.spirv.len(), 2);
+        assert_eq!(*back.spirv[&5], vec![0x0723_0203, 1, 2, 3]);
+        assert!(Manifest::decode(b"nope").is_none());
+        assert!(Manifest::decode(&m.encode()[..20]).is_none());
+    }
+}
