+    #[test]
+    #[ignore]
+    fn render_menu_offscreen() {
+        let Ok(mut r) = Renderer::new() else { return };
+        let (w, h) = (1280u32, 720u32);
+        let key = ImageKey { cpu: 0x7000_0000, format: vk::Format::R8G8B8A8_UNORM, width: w, height: h };
+        r.create_image(key, 1, 1).unwrap();
+        let grey = vec![0x60u8; (w * h * 4) as usize];
+        r.upload(key, &[(w, h, grey)]);
+        let view = r.view(key, key.format, [vk::ComponentSwizzle::IDENTITY; 4]);
+        crate::overlay::test_open(0);
+        let verts = crate::overlay::build(w, h);
+        assert!(!verts.is_empty());
+        r.begin();
+        r.end_rendering();
+        let image = r.images[&key].image;
+        let mut o = unsafe { OverlayGpu::new(&r.device, &r.mem_props, r.cmd, key.format, r.batches.len()) }.unwrap();
+        let (device, props, cmd, slot) = (r.device.clone(), r.mem_props, r.cmd, r.current);
+        unsafe { o.record(&device, &props, cmd, slot, image, view, vk::ImageLayout::GENERAL, vk::Extent2D { width: w, height: h }, &verts) }.unwrap();
+        r.finish();
+        let bytes = r.read_raw(key, 1).unwrap();
+        unsafe { o.destroy(&r.device) };
+        let px: Vec<u32> = bytes.chunks_exact(4).map(|p| (p[0] as u32) << 16 | (p[1] as u32) << 8 | p[2] as u32).collect();
+        if let Ok(path) = std::env::var("KIRIKAE_OVERLAY_PNG") {
+            crate::display::write_png(std::path::Path::new(&path), w, h, &px).unwrap();
+        }
+        // the highlight bar of the selected row is blue
+        assert!(px.iter().any(|&p| (p & 0xff) > 0x90 && (p >> 16) < 0x60));
+    }
+}
diff --git a/crates/rt/src/gpu/vulkan/overlay.wgsl b/crates/rt/src/gpu/vulkan/overlay.wgsl
new file mode 100644
index 0000000..70c3647
--- /dev/null
+++ b/crates/rt/src/gpu/vulkan/overlay.wgsl
@@ -0,0 +1,26 @@
+// Settings-menu overlay: solid rectangles (u < 0) and font glyphs (alpha from the R8 atlas).
+struct Push { screen: vec2<f32>, srgb: u32, pad: u32 }
+var<immediate> pc: Push;
+@group(0) @binding(0) var font: texture_2d<f32>;
+@group(0) @binding(1) var font_sampler: sampler;
+
+struct VOut { @builtin(position) pos: vec4<f32>, @location(0) uv: vec2<f32>, @location(1) color: vec4<f32> }
+
+@vertex
+fn vs(@location(0) p: vec2<f32>, @location(1) uv: vec2<f32>, @location(2) c: vec4<f32>) -> VOut {
+    var o: VOut;
+    o.pos = vec4<f32>(p.x / pc.screen.x * 2.0 - 1.0, p.y / pc.screen.y * 2.0 - 1.0, 0.0, 1.0);
+    o.uv = uv;
+    o.color = c;
+    return o;
+}
+
+@fragment
+fn fs(i: VOut) -> @location(0) vec4<f32> {
+    var a = 1.0;
+    if (i.uv.x >= 0.0) { a = textureSample(font, font_sampler, i.uv).r; }
+    var rgb = i.color.rgb;
+    // The menu colours are display (sRGB) values; an sRGB swapchain re-encodes what we write.
+    if (pc.srgb != 0u) { rgb = pow(rgb, vec3<f32>(2.2)); }
+    return vec4<f32>(rgb, i.color.a * a);
+}
