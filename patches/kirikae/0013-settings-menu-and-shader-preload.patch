+//! Keyboard and controller bindings for the Switch controls, changed from the settings menu
+//! and stored in the `[keyboard]` / `[controller]` sections of the settings file.
+//!
+//! Controller inputs use Xbox-style (SDL game controller) names: a b x y, leftshoulder,
+//! rightshoulder, lefttrigger, righttrigger, start, back, leftstick, rightstick, dpup dpdown
+//! dpleft dpright, and stick directions leftx- leftx+ lefty- (up) lefty+ (down), same for right.
+
+use std::sync::Mutex;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+use winit::keyboard::KeyCode;
+
+use crate::input::{PadState, STICK_MAX, button};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Out {
+    Button(u64),
+    Left(i32, i32),
+    Right(i32, i32),
+}
+
+pub struct Control {
+    pub id: &'static str,
+    pub label: &'static str,
+    pub key_default: &'static str,
+    pub pad_default: &'static str,
+    pub out: Out,
+}
+
+pub static CONTROLS: &[Control] = &[
+    Control { id: "a", label: "A", key_default: "Z Space", pad_default: "a", out: Out::Button(button::A) },
+    Control { id: "b", label: "B", key_default: "X", pad_default: "b", out: Out::Button(button::B) },
+    Control { id: "x", label: "X", key_default: "C", pad_default: "x", out: Out::Button(button::X) },
+    Control { id: "y", label: "Y", key_default: "V", pad_default: "y", out: Out::Button(button::Y) },
+    Control { id: "l", label: "L", key_default: "E", pad_default: "leftshoulder", out: Out::Button(button::L) },
+    Control { id: "r", label: "R", key_default: "U", pad_default: "rightshoulder", out: Out::Button(button::R) },
+    Control { id: "zl", label: "ZL", key_default: "Q", pad_default: "lefttrigger", out: Out::Button(button::ZL) },
+    Control { id: "zr", label: "ZR", key_default: "O", pad_default: "righttrigger", out: Out::Button(button::ZR) },
+    Control { id: "plus", label: "+ (Plus)", key_default: "Enter", pad_default: "start", out: Out::Button(button::PLUS) },
+    Control { id: "minus", label: "- (Minus)", key_default: "Backspace", pad_default: "back", out: Out::Button(button::MINUS) },
+    Control { id: "dpad_up", label: "D-pad up", key_default: "T", pad_default: "dpup", out: Out::Button(button::UP) },
+    Control { id: "dpad_down", label: "D-pad down", key_default: "G", pad_default: "dpdown", out: Out::Button(button::DOWN) },
+    Control { id: "dpad_left", label: "D-pad left", key_default: "F", pad_default: "dpleft", out: Out::Button(button::LEFT) },
+    Control { id: "dpad_right", label: "D-pad right", key_default: "H", pad_default: "dpright", out: Out::Button(button::RIGHT) },
+    Control { id: "lstick_up", label: "Left stick up", key_default: "W Up", pad_default: "lefty-", out: Out::Left(0, 1) },
+    Control { id: "lstick_down", label: "Left stick down", key_default: "S Down", pad_default: "lefty+", out: Out::Left(0, -1) },
+    Control { id: "lstick_left", label: "Left stick left", key_default: "A Left", pad_default: "leftx-", out: Out::Left(-1, 0) },
+    Control { id: "lstick_right", label: "Left stick right", key_default: "D Right", pad_default: "leftx+", out: Out::Left(1, 0) },
+    Control { id: "lstick_click", label: "Left stick click", key_default: "LShift", pad_default: "leftstick", out: Out::Button(button::STICK_L) },
+    Control { id: "rstick_up", label: "Right stick up", key_default: "I", pad_default: "righty-", out: Out::Right(0, 1) },
+    Control { id: "rstick_down", label: "Right stick down", key_default: "K", pad_default: "righty+", out: Out::Right(0, -1) },
+    Control { id: "rstick_left", label: "Right stick left", key_default: "J", pad_default: "rightx-", out: Out::Right(-1, 0) },
+    Control { id: "rstick_right", label: "Right stick right", key_default: "L", pad_default: "rightx+", out: Out::Right(1, 0) },
+    Control { id: "rstick_click", label: "Right stick click", key_default: "M", pad_default: "rightstick", out: Out::Button(button::STICK_R) },
+];
+
+/// Key names written to the settings file and shown in the menu. Esc, F1 and F11 are kept
+/// for the menu and fullscreen.
+const KEY_NAMES: &[(KeyCode, &str)] = {
