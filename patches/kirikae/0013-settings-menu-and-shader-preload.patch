+    &[
+        (K::KeyA, "A"), (K::KeyB, "B"), (K::KeyC, "C"), (K::KeyD, "D"), (K::KeyE, "E"), (K::KeyF, "F"), (K::KeyG, "G"),
+        (K::KeyH, "H"), (K::KeyI, "I"), (K::KeyJ, "J"), (K::KeyK, "K"), (K::KeyL, "L"), (K::KeyM, "M"), (K::KeyN, "N"),
+        (K::KeyO, "O"), (K::KeyP, "P"), (K::KeyQ, "Q"), (K::KeyR, "R"), (K::KeyS, "S"), (K::KeyT, "T"), (K::KeyU, "U"),
+        (K::KeyV, "V"), (K::KeyW, "W"), (K::KeyX, "X"), (K::KeyY, "Y"), (K::KeyZ, "Z"),
+        (K::Digit0, "0"), (K::Digit1, "1"), (K::Digit2, "2"), (K::Digit3, "3"), (K::Digit4, "4"),
+        (K::Digit5, "5"), (K::Digit6, "6"), (K::Digit7, "7"), (K::Digit8, "8"), (K::Digit9, "9"),
+        (K::ArrowUp, "Up"), (K::ArrowDown, "Down"), (K::ArrowLeft, "Left"), (K::ArrowRight, "Right"),
+        (K::Space, "Space"), (K::Enter, "Enter"), (K::Backspace, "Backspace"), (K::Tab, "Tab"), (K::CapsLock, "CapsLock"),
+        (K::ShiftLeft, "LShift"), (K::ShiftRight, "RShift"), (K::ControlLeft, "LCtrl"), (K::ControlRight, "RCtrl"),
+        (K::AltLeft, "LAlt"), (K::AltRight, "RAlt"),
+        (K::Insert, "Insert"), (K::Delete, "Delete"), (K::Home, "Home"), (K::End, "End"), (K::PageUp, "PageUp"), (K::PageDown, "PageDown"),
+        (K::Minus, "Minus"), (K::Equal, "Equal"), (K::BracketLeft, "["), (K::BracketRight, "]"), (K::Semicolon, ";"),
+        (K::Quote, "'"), (K::Comma, ","), (K::Period, "."), (K::Slash, "/"), (K::Backslash, "\\"), (K::Backquote, "`"),
+        (K::F2, "F2"), (K::F3, "F3"), (K::F4, "F4"), (K::F5, "F5"), (K::F6, "F6"), (K::F7, "F7"), (K::F8, "F8"),
+        (K::F9, "F9"), (K::F10, "F10"), (K::F12, "F12"),
+        (K::Numpad0, "Num0"), (K::Numpad1, "Num1"), (K::Numpad2, "Num2"), (K::Numpad3, "Num3"), (K::Numpad4, "Num4"),
+        (K::Numpad5, "Num5"), (K::Numpad6, "Num6"), (K::Numpad7, "Num7"), (K::Numpad8, "Num8"), (K::Numpad9, "Num9"),
+        (K::NumpadAdd, "NumAdd"), (K::NumpadSubtract, "NumSub"), (K::NumpadMultiply, "NumMul"), (K::NumpadDivide, "NumDiv"),
+        (K::NumpadEnter, "NumEnter"), (K::NumpadDecimal, "NumDot"),
+    ]
+};
+
+pub fn key_name(code: KeyCode) -> Option<&'static str> {
+    KEY_NAMES.iter().find(|(k, _)| *k == code).map(|(_, n)| *n)
+}
+
+fn key_code(name: &str) -> Option<KeyCode> {
+    KEY_NAMES.iter().find(|(_, n)| n.eq_ignore_ascii_case(name)).map(|(k, _)| *k)
+}
+
+/// Raw controller state in XInput layout (buttons bits, triggers 0-255, sticks with up positive).
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct RawPad {
+    pub buttons: u16,
+    pub lt: u8,
+    pub rt: u8,
+    pub lx: i16,
+    pub ly: i16,
+    pub rx: i16,
+    pub ry: i16,
+}
+
+pub mod xb {
+    pub const DPUP: u16 = 0x0001;
+    pub const DPDOWN: u16 = 0x0002;
+    pub const DPLEFT: u16 = 0x0004;
+    pub const DPRIGHT: u16 = 0x0008;
+    pub const START: u16 = 0x0010;
+    pub const BACK: u16 = 0x0020;
+    pub const LSTICK: u16 = 0x0040;
+    pub const RSTICK: u16 = 0x0080;
+    pub const LB: u16 = 0x0100;
+    pub const RB: u16 = 0x0200;
+    pub const A: u16 = 0x1000;
+    pub const B: u16 = 0x2000;
+    pub const X: u16 = 0x4000;
+    pub const Y: u16 = 0x8000;
+}
+
+const PAD_BUTTONS: &[(&str, u16)] = &[
+    ("a", xb::A),
+    ("b", xb::B),
+    ("x", xb::X),
+    ("y", xb::Y),
+    ("leftshoulder", xb::LB),
+    ("rightshoulder", xb::RB),
+    ("start", xb::START),
+    ("back", xb::BACK),
+    ("leftstick", xb::LSTICK),
+    ("rightstick", xb::RSTICK),
+    ("dpup", xb::DPUP),
+    ("dpdown", xb::DPDOWN),
+    ("dpleft", xb::DPLEFT),
+    ("dpright", xb::DPRIGHT),
+];
+
+const LEFT_DEAD: i32 = 7849;
+const RIGHT_DEAD: i32 = 8689;
+
+fn axis(v: i16, dead: i32) -> f32 {
+    let v = (v as i32).clamp(-STICK_MAX, STICK_MAX);
+    if v.abs() < dead { 0.0 } else { (v.abs() - dead) as f32 / (STICK_MAX - dead) as f32 * v.signum() as f32 }
+}
+
+/// How far an input is pressed, 0 to 1.
+pub fn input_value(raw: &RawPad, name: &str) -> f32 {
+    if let Some((_, bit)) = PAD_BUTTONS.iter().find(|(n, _)| *n == name) {
+        return if raw.buttons & bit != 0 { 1.0 } else { 0.0 };
+    }
+    let dir = |v: f32, neg: bool| if neg { (-v).max(0.0) } else { v.max(0.0) };
+    match name {
+        "lefttrigger" => raw.lt as f32 / 255.0,
+        "righttrigger" => raw.rt as f32 / 255.0,
+        "leftx-" | "leftx+" => dir(axis(raw.lx, LEFT_DEAD), name.ends_with('-')),
+        // SDL convention: y- is up; XInput reports up as positive
+        "lefty-" | "lefty+" => dir(axis(raw.ly, LEFT_DEAD), name.ends_with('+')),
+        "rightx-" | "rightx+" => dir(axis(raw.rx, RIGHT_DEAD), name.ends_with('-')),
+        "righty-" | "righty+" => dir(axis(raw.ry, RIGHT_DEAD), name.ends_with('+')),
+        _ => 0.0,
+    }
+}
+
+pub fn known_input(name: &str) -> bool {
+    PAD_BUTTONS.iter().any(|(n, _)| *n == name)
+        || matches!(name, "lefttrigger" | "righttrigger" | "leftx-" | "leftx+" | "lefty-" | "lefty+" | "rightx-" | "rightx+" | "righty-" | "righty+")
+}
+
+/// The input that went from released to firmly pressed between two polls, for binding.
+pub fn newly_pressed(prev: &RawPad, now: &RawPad) -> Option<&'static str> {
+    const ALL: &[&str] = &[
+        "a", "b", "x", "y", "leftshoulder", "rightshoulder", "start", "back", "leftstick", "rightstick", "dpup", "dpdown", "dpleft", "dpright",
+        "lefttrigger", "righttrigger", "leftx-", "leftx+", "lefty-", "lefty+", "rightx-", "rightx+", "righty-", "righty+",
+    ];
+    ALL.iter().copied().find(|n| input_value(now, n) > 0.75 && input_value(prev, n) <= 0.4)
+}
+
+/// Swap A/B and X/Y on the raw pad (Nintendo layout by position).
+pub fn swap_face(raw: &mut RawPad) {
+    let b = raw.buttons;
+    let pick = |from: u16, to: u16| if b & from != 0 { to } else { 0 };
+    raw.buttons = (b & !(xb::A | xb::B | xb::X | xb::Y)) | pick(xb::A, xb::B) | pick(xb::B, xb::A) | pick(xb::X, xb::Y) | pick(xb::Y, xb::X);
+}
+
+static VERSION: AtomicU64 = AtomicU64::new(1);
+
+struct Resolved {
+    version: u64,
+    keys: Vec<(Vec<KeyCode>, Out)>,
+    pad: Vec<(Vec<String>, Out)>,
+}
+
+static RESOLVED: Mutex<Option<Resolved>> = Mutex::new(None);
+
+fn names(stored: Option<&String>, default: &str) -> Vec<String> {
+    match stored.map(|s| s.trim()) {
+        Some("none") | Some("") => Vec::new(),
+        Some(s) => s.split_whitespace().map(str::to_string).collect(),
+        None => default.split_whitespace().map(str::to_string).collect(),
+    }
+}
+
+fn with_resolved<R>(f: impl FnOnce(&Resolved) -> R) -> R {
+    let mut r = RESOLVED.lock().unwrap();
+    let v = VERSION.load(Ordering::Relaxed);
+    if r.as_ref().is_none_or(|r| r.version != v) {
+        let (keys, pad) = (crate::settings::keys(), crate::settings::pad());
+        *r = Some(Resolved {
+            version: v,
+            keys: CONTROLS.iter().map(|c| (names(keys.get(c.id), c.key_default).iter().filter_map(|n| key_code(n)).collect(), c.out)).collect(),
+            pad: CONTROLS.iter().map(|c| (names(pad.get(c.id), c.pad_default).into_iter().filter(|n| known_input(n)).collect(), c.out)).collect(),
+        });
+    }
+    f(r.as_ref().unwrap())
+}
+
+fn combine(outs: impl Iterator<Item = (Out, f32)>) -> PadState {
+    let (mut buttons, mut l, mut r) = (0u64, [0f32; 4], [0f32; 4]);
+    let slot = |x: i32, y: i32| match (x, y) {
+        (-1, 0) => 0,
+        (1, 0) => 1,
+        (0, 1) => 2,
+        _ => 3,
+    };
+    for (out, v) in outs {
+        match out {
+            Out::Button(b) if v > 0.1 => buttons |= b,
+            Out::Button(_) => {}
+            Out::Left(x, y) => l[slot(x, y)] = l[slot(x, y)].max(v),
+            Out::Right(x, y) => r[slot(x, y)] = r[slot(x, y)].max(v),
+        }
+    }
+    let stick = |s: [f32; 4]| {
+        let (x, y) = (s[1] - s[0], s[2] - s[3]);
+        // full digital diagonals (keys) stay on the unit circle; analog values pass through
+        let k = if x.abs() >= 1.0 && y.abs() >= 1.0 { std::f32::consts::FRAC_1_SQRT_2 } else { 1.0 };
+        let (x, y) = (x.clamp(-1.0, 1.0), y.clamp(-1.0, 1.0));
+        ((x * k * STICK_MAX as f32) as i32, (y * k * STICK_MAX as f32) as i32)
+    };
+    PadState { buttons, left: stick(l), right: stick(r) }
+}
+
+pub fn keyboard(pressed: &dyn Fn(KeyCode) -> bool) -> PadState {
+    with_resolved(|r| combine(r.keys.iter().map(|(keys, out)| (*out, if keys.iter().any(|k| pressed(*k)) { 1.0 } else { 0.0 }))))
+}
+
+pub fn pad(raw: &RawPad) -> PadState {
+    with_resolved(|r| combine(r.pad.iter().map(|(ins, out)| (*out, ins.iter().map(|n| input_value(raw, n)).fold(0.0, f32::max)))))
+}
+
+/// Shown in the menu.
+pub fn key_binding(i: usize) -> String {
+    let keys = crate::settings::keys();
+    names(keys.get(CONTROLS[i].id), CONTROLS[i].key_default).join(" ")
+}
+
+pub fn pad_binding(i: usize) -> String {
+    let pad = crate::settings::pad();
+    names(pad.get(CONTROLS[i].id), CONTROLS[i].pad_default).join(" ")
+}
+
+fn store(map: &mut std::collections::BTreeMap<String, String>, i: usize, value: &str, default: &str) {
+    let id = CONTROLS[i].id.to_string();
+    if value == default {
+        map.remove(&id);
+    } else {
+        map.insert(id, if value.is_empty() { "none".into() } else { value.into() });
+    }
+}
+
+pub fn set_key(i: usize, name: &str) {
+    crate::settings::update(|f| store(&mut f.keys, i, name, CONTROLS[i].key_default));
+    VERSION.fetch_add(1, Ordering::Relaxed);
+}
+
+pub fn set_pad(i: usize, name: &str) {
+    crate::settings::update(|f| store(&mut f.pad, i, name, CONTROLS[i].pad_default));
+    VERSION.fetch_add(1, Ordering::Relaxed);
+}
+
+pub fn reset_keys() {
+    crate::settings::update(|f| f.keys.clear());
+    VERSION.fetch_add(1, Ordering::Relaxed);
+}
+
+pub fn reset_pad() {
+    crate::settings::update(|f| f.pad.clear());
+    VERSION.fetch_add(1, Ordering::Relaxed);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn default_keyboard_matches_the_old_map() {
+        let held = [KeyCode::KeyZ, KeyCode::ArrowUp, KeyCode::KeyD, KeyCode::KeyL];
+        let s = keyboard(&|k| held.contains(&k));
+        assert_eq!(s.buttons, button::A);
+        assert!(s.left.0 > 20000 && s.left.0 == s.left.1, "diagonal: {:?}", s.left);
+        assert_eq!(s.right, (STICK_MAX, 0));
+    }
+
+    #[test]
+    fn default_pad_by_label_and_analog_sticks() {
+        let raw = RawPad { buttons: xb::A | xb::START, rt: 200, lx: -STICK_MAX as i16, ly: 16000, ..Default::default() };
+        let s = pad(&raw);
+        assert_eq!(s.buttons, button::A | button::PLUS | button::ZR);
+        assert_eq!(s.left.0, -STICK_MAX);
+        assert!(s.left.1 > 8000 && s.left.1 < 16000, "{:?}", s.left);
+        let mut swapped = raw;
+        swap_face(&mut swapped);
+        assert_eq!(pad(&swapped).buttons, button::B | button::PLUS | button::ZR);
+    }
+
+    #[test]
+    fn capture_names() {
+        let prev = RawPad::default();
+        assert_eq!(newly_pressed(&prev, &RawPad { buttons: xb::RB, ..prev }), Some("rightshoulder"));
+        assert_eq!(newly_pressed(&prev, &RawPad { ly: 30000, ..prev }), Some("lefty-"));
+        assert_eq!(newly_pressed(&prev, &RawPad { lt: 250, ..prev }), Some("lefttrigger"));
+        assert_eq!(newly_pressed(&prev, &RawPad { lt: 100, ..prev }), None);
+        assert_eq!(key_name(KeyCode::ShiftLeft), Some("LShift"));
+        assert_eq!(key_code("lshift"), Some(KeyCode::ShiftLeft));
+        assert_eq!(key_name(KeyCode::F1), None);
+    }
+}
