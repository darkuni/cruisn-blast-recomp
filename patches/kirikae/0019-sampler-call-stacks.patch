+/// Guest functions on the sample's call stack: lr, then the x29 frame-record chain.
+fn stack(p: &Process, s: &Sample) -> Vec<u64> {
+    let start_of = |a: u64| {
+        let i = p.entries.partition_point(|e| e.addr <= a);
+        i.checked_sub(1).map(|i| p.entries[i].addr)
+    };
+    let mut out: Vec<u64> = Vec::new();
+    let mut push = |f: Option<u64>| {
+        if let Some(f) = f
+            && !out.contains(&f)
+        {
+            out.push(f);
+        }
+    };
+    push(start_of(s.lr.wrapping_sub(4)));
+    let mut fp = s.fp;
+    for _ in 0..24 {
+        if fp == 0 || fp % 8 != 0 {
+            break;
+        }
+        let Some(rec) = p.memory.bytes(fp, 16) else { break };
+        let next = u64::from_le_bytes(rec[..8].try_into().unwrap());
+        let ret = u64::from_le_bytes(rec[8..].try_into().unwrap());
+        push(start_of(ret.wrapping_sub(4)));
+        if next <= fp {
+            break;
+        }
+        fp = next;
+    }
+    out
+}
